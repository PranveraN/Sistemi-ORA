generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  active           Boolean           @default(true)
  plan             String            @default("trial") // trial, basic, pro
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  classes          Class[]
  students         Student[]
  paymentCategories PaymentCategory[]
  payments         Payment[]
  invoices         Invoice[]
  schoolYears      SchoolYear[]
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  password       String
  role           String       @default("SECRETARY") // ADMIN, FINANCE, SECRETARY, SUPERADMIN
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  shpenzimBulkActions ShpenzimBulkAction[]
  promotionRuns  PromotionRun[]
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  level          String
  teacher        String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  students       Student[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Student {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  parentName     String?
  birthDate      DateTime?
  personalNumber String?
  classId        Int?
  class          Class?    @relation(fields: [classId], references: [id])
  libriAme       LibriAme?
  familyId       String?   // FAM-001, FAM-002, etj.
  discountPct    Float     @default(0) // Zbritja % (vëlla/motër)
  guardian       String?
  motherNumber   String?
  diaryNumber    String?
  parentPhone    String?
  address        String?
  // Mother
  motherName     String?
  motherBirth    DateTime?
  motherProf     String?
  motherPhone    String?
  motherEmail    String?
  // Father
  fatherName     String?
  fatherBirth    DateTime?
  fatherProf     String?
  fatherPhone    String?
  fatherEmail    String?
  kontrata       String?   // Po, Nuk e ka kthy, Nuk ka
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  enrollDate     DateTime  @default(now())
  inactiveDate   DateTime?
  notes          String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  invoices       Invoice[]
  yearHistory    StudentYearHistory[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([classId])
  @@index([parentPhone])
  @@index([fatherPhone])
  @@index([motherPhone])
}

model PaymentCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  type           String       @default("monthly")
  defaultAmount  Float        @default(0)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  expenses       Expense[]
  prices         PaymentCategoryPrice[]
  createdAt      DateTime     @default(now())
}

// ── Vitet Shkollore ───────────────────────────────────────

model SchoolYear {
  id             Int      @id @default(autoincrement())
  label          String   // "2026-2027"
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean  @default(false)
  organizationId Int      @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  prices         PaymentCategoryPrice[]
  studentHistory StudentYearHistory[]
  promotions     PromotionRun[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, label])
  @@index([organizationId, active])
}

model PaymentCategoryPrice {
  id            Int             @id @default(autoincrement())
  categoryId    Int
  category      PaymentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schoolYearId  Int
  schoolYear    SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  defaultAmount Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([categoryId, schoolYearId])
  @@index([schoolYearId])
}

// Foto e ngrirë e gjendjes së nxënësit PARA çdo kalimi viti — s'lidhet live
// me Class (mund të riemërtohet/fshihet më vonë), prandaj ruan tekst të ngrirë.
model StudentYearHistory {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  classId      Int?       // referencë e thjeshtë, pa @relation — s'bllokon fshirjen e Class
  className    String?
  classLevel   String?
  discountPct  Float      @default(0)
  status       String     // ACTIVE/INACTIVE në kohën e arkivimit
  studentName  String
  outcome      String     // PROMOTED | REPEATED | GRADUATED | LEFT
  newClassId   Int?
  newClassName String?
  createdAt    DateTime   @default(now())

  @@unique([studentId, schoolYearId])
  @@index([schoolYearId])
}

model PromotionRun {
  id              Int        @id @default(autoincrement())
  fromYearId      Int?
  toYearId        Int
  toYear          SchoolYear @relation(fields: [toYearId], references: [id])
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  studentCount    Int
  promotedCount   Int
  repeatedCount   Int
  graduatedCount  Int
  leftCount       Int
  requestSnapshot String     // JSON e vendimeve të aplikuara
  createdAt       DateTime   @default(now())

  @@index([toYearId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    PaymentCategory @relation(fields: [categoryId], references: [id])
  type        String          // "EXPENSE" | "HANDOVER"
  amount      Float
  description String?
  recipient   String?
  date        DateTime        @default(now())
  method      String?
  reference   String?
  month       Int?
  year        Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Sipartner {
  id        Int      @id @default(autoincrement())
  emri      String
  nrFiskal  String?
  adresa    String?
  telefoni  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emri])
}

model ShpenzimKategori {
  id        Int        @id @default(autoincrement())
  emri      String
  ngjyra    String?    // hex color, p.sh. "#ef4444"
  ikona     String?    // emoji ose emër ikone
  shpenzime Shpenzim[]
  createdAt DateTime   @default(now())
}

model Shpenzim {
  id         Int              @id @default(autoincrement())
  kategoriId Int
  kategori   ShpenzimKategori @relation(fields: [kategoriId], references: [id])
  shuma      Float
  pershkrim  String?
  marres     String?
  data       DateTime         @default(now())
  metoda     String?          // CASH, BANK, CARD
  referenca  String?
  docType      String           @default("KUPON") // KUPON, FATURE, OFERTE
  lloji        String           @default("ZYRE")  // ZYRE, BANKE
  paguar       Boolean          @default(true)     // true = paguar, false = borxh
  nrFature     String?          // numri i faturës
  emriBiznesit String?          // emri i biznesit/furnitorit
  nrFiskal     String?          // numri fiskal i biznesit
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([kategoriId])
  @@index([data])
}

// Historik i veprimeve masive (bulk) mbi Shpenzim — lejon "Zhbëj" kur një
// ndryshim/fshirje masive aplikohet gabimisht mbi rreshta të gabuar.
model ShpenzimBulkAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "PATCH" ose "DELETE"
  snapshot  String   // JSON: gjendja e plotë e rreshtave përpara veprimit
  count     Int
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Payment {
  id            Int              @id @default(autoincrement())
  studentId     Int
  student       Student          @relation(fields: [studentId], references: [id])
  categoryId    Int
  category      PaymentCategory  @relation(fields: [categoryId], references: [id])
  amount        Float
  discount      Float            @default(0)
  discountType  String?          // percentage, fixed
  scholarship   Float            @default(0)
  finalAmount   Float
  dueDate       DateTime
  paidDate      DateTime?
  paidAmount    Float            @default(0)
  balance       Float            @default(0)
  method        String?          // CASH, BANK, CARD, ONLINE
  status        String           @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  description   String?
  invoiceId     Int?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  month         Int?             // 1-12 for monthly payments
  year          Int?
  receiptNumber  String?          @unique
  organizationId Int              @default(1)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  type        String        // INVOICE, PROFORMA, OFFER
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id])
  items       InvoiceItem[]
  subtotal    Float
  vatRate     Float         @default(0)
  vatAmount   Float         @default(0)
  total       Float
  status      String        @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
}

// ── Sistemi i Uniformave ──────────────────────────────────

model UniProduct {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  buyPrice    Float
  sellPrice   Float
  stock       Int           @default(0)
  stockAlert  Int           @default(5)
  active      Boolean       @default(true)
  saleItems   UniSaleItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model UniSale {
  id            Int           @id @default(autoincrement())
  customerName  String
  customerPhone String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float         @default(0)
  balance       Float         @default(0)
  status        String        @default("PENDING")
  saleDate      DateTime      @default(now())
  notes         String?
  items         UniSaleItem[]
  payments      UniPayment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model UniSaleItem {
  id        Int        @id @default(autoincrement())
  saleId    Int
  sale      UniSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   UniProduct @relation(fields: [productId], references: [id])
  size      String?
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model UniPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      UniSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model UniHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  recipient   String?
  method      String   @default("CASH")
  handoverAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
}

// ── Librat e Anglishtes ───────────────────────────────────

model BookProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  buyPrice    Float
  sellPrice   Float
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookSale {
  id            Int      @id @default(autoincrement())
  studentId     Int?
  studentName   String
  studentClass  String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float    @default(0)
  balance       Float    @default(0)
  status        String   @default("PENDING")
  receiptNumber String?
  saleDate      DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BookSaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model BookPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Student, Payment, Invoice, etc.
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ── TIMI INVEST ───────────────────────────────────────────

model TimiInvestStudent {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  parentName   String
  parentPhone  String
  regularPrice    Float
  discountPct     Float    @default(0)
  manualDiscAmt   Float    @default(0)
  studentId    Int?     // lidhje me Student.id kryesor (opsionale)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TimiInvestInvoice {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  seq              Int
  month            Int
  year             Int
  parentName       String
  date             DateTime @default(now())
  items            String   // JSON: [{name, regularPrice, discountPct, finalAmount}]
  timiStudentIds   String?  // JSON: [TimiInvestStudent.id, ...] — lidhje e qëndrueshme me fëmijët
  totalAmount      Float
  timiDiscPct      Float    @default(4.66)
  timiDiscAmt      Float
  finalAmount      Float
  notes            String?
  schoolYear       String?
  regularInvoiceId Int?     @unique // Invoice.id — nëse është konvertuar në faturë të rregullt
  createdAt        DateTime @default(now())
}

// ── Fletorja Digjitale e Adminit ──────────────────────────

model AdminNote {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String
  color     String   @default("slate") // slate, blue, yellow, green, red, purple, orange
  tags      String?  // comma-separated
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  assignedTo  String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminReminder {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   @default("GENERAL") // PAYMENT, MEETING, DOCUMENT, GENERAL
  dueDate     DateTime
  done        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("GENERAL") // EXAM, MEETING, ACTIVITY, HOLIDAY, GENERAL
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Stafi ─────────────────────────────────────────────────

model Staff {
  id          Int      @id @default(autoincrement())
  emri        String
  telefoni    String?
  lenda       String?
  nrPersonal  String?
  nrLlogarise String?
  banka       String?
  totalBruto  Float?
  kontrata        String?
  llojiKontrates  String?
  cmimOres        Float?
  oreMuaj         Int?
  adresa          String?
  kodi            String?
  tipi            String?
  status          String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Investim {
  id             Int      @id @default(autoincrement())
  tipi           String   // KAPITAL, PERKOHSHEM
  data           DateTime @default(now())
  pershkrim      String
  kategoria      String?
  vlera          Float
  metoda         String   @default("CASH") // CASH, BANK, CARD, TRANSFER
  dokumenti      String?
  regjistruarNga String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipi])
  @@index([data])
}

model Hyra {
  id        Int      @id @default(autoincrement())
  paguesit  String
  shuma     Float
  kategoria String   @default("SHKOLLIMI")
  muaj      Int
  vit       Int
  metoda    String?  // CASH, BANK
  referenca String?
  shenime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vit, muaj])
  @@index([paguesit])
}

model DocArchive {
  id          Int      @id @default(autoincrement())
  type        String   // FLETEKALIM_CL, FLETEKALIM_CU, PASQYRE_CU, VERTETIM_CL
  studentId   Int?
  studentName String
  className   String?
  data        String   // JSON: të gjitha fushat e modalit
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([studentId])
  @@index([createdAt])
}

model LibriAme {
  id            Int      @id @default(autoincrement())
  studentId     Int      @unique
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vendiLindjes  String?
  shteti        String?
  shtetas       String?
  komuna        String?
  adresaPrindit String?
  notat         String?  // JSON: grades Kl.6-9
  levizjet      String?  // JSON: page 2 Kl.6-9
  notatFillore  String?  // JSON: grades Kl.1-5
  levizjetFillore String? // JSON: page 2 Kl.1-5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
