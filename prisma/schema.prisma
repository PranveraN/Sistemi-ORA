generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  active           Boolean           @default(true)
  plan             String            @default("trial") // trial, basic, pro
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  classes          Class[]
  students         Student[]
  paymentCategories PaymentCategory[]
  payments         Payment[]
  invoices         Invoice[]
  schoolYears      SchoolYear[]
  materialRequests MaterialRequest[]
  familyReceipts   FamilyReceipt[]
  materialCategories MaterialCategory[]
  subjects         Subject[]
  materials        Material[]
  materialOrders   MaterialOrder[]
  materialInventoryTransactions MaterialInventoryTransaction[]
  smsMessages      SmsMessage[]
  paymentHandovers PaymentHandover[]
  studentNotes     StudentNote[]
  enrollmentApplications EnrollmentApplication[]
  studentEvidenca  StudentEvidenca[]
  applicationEvidenca ApplicationEvidenca[]
  schoolDocuments  SchoolDocument[]
  familyEmailLogs  FamilyEmailLog[]
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  password       String
  role           String       @default("SECRETARY") // ADMIN, FINANCE, SECRETARY, SUPERADMIN, TEACHER, PEDAGOGIA (vetëm /classes)
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  shpenzimBulkActions ShpenzimBulkAction[]
  promotionRuns  PromotionRun[]
  materialRequests         MaterialRequest[] @relation("MaterialRequestTeacher")
  reviewedMaterialRequests MaterialRequest[] @relation("MaterialRequestReviewer")
  materialRequestStatusChanges MaterialRequestStatusHistory[] @relation("MaterialRequestStatusChangedBy")
  createdMaterialOrders    MaterialOrder[]
  materialInventoryTransactions MaterialInventoryTransaction[]
  sentSmsMessages          SmsMessage[]
  studentNotes             StudentNote[]
  evidencaRecords          StudentEvidenca[]
  applicationEvidencaRecords ApplicationEvidenca[]
  uploadedDocuments        SchoolDocument[]
  documentsSent            DocumentEmailLog[]
  familyEmailsSent         FamilyEmailLog[]
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  level          String
  teacher        String?
  capacity       Int?         // Numri max i nxënësve — bosh = pa limit (përdoret te aplikimi publik i regjistrimit, shih EnrollmentApplication)
  active         Boolean      @default(true) // A është kjo paralele e hapur/funksionale këtë vit — një paralele joaktive (p.sh. bosh, e pahapur) NUK numërohet si "vend i lirë" te kontrolli i kapacitetit
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  students       Student[]
  materialRequests MaterialRequest[]
  enrollmentApplications EnrollmentApplication[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Student {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  parentName     String?
  birthDate      DateTime?
  personalNumber String?
  gender         String?
  classId        Int?
  class          Class?    @relation(fields: [classId], references: [id])
  libriAme       LibriAme?
  familyId       String?   // FAM-001, FAM-002, etj.
  discountPct    Float     @default(0) // Zbritja % (vëlla/motër)
  guardian       String?
  motherNumber   String?
  diaryNumber    String?
  parentPhone    String?
  address        String?
  // Mother
  motherName     String?
  motherBirth    DateTime?
  motherProf     String?
  motherPhone    String?
  motherEmail    String?
  // Father
  fatherName     String?
  fatherBirth    DateTime?
  fatherProf     String?
  fatherPhone    String?
  fatherEmail    String?
  kontrata       String?   // Po, Nuk e ka kthy, Nuk ka
  paymentPlan    String?   // FULL, TWO, MONTHLY, TIMI_INVEST — synimi/regjistrimi i menyres se pageses
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  enrollDate     DateTime  @default(now())
  originCountry  String?   // Vendi nga ka ardhur (kur eshte nxenes i ardhur nga jashte Kosoves)
  previousSchool String?   // Shkolla paraardhese (nga ka ardhur nxenesi)
  transferResult String?   // Suksesi/rezultati i fletekalimit nga shkolla paraardhese
  admissionScore Float?    // Piket ne testin pranues "Ora"
  studentRating  String?   // Vleresim i mesuesve — etikete fikse (shih STUDENT_RATINGS)
  hideFromNewRegistrations Boolean @default(false) // Hequr manualisht nga karta "Nxenes te Rinj" (p.sh. enrollDate gabim nga nje import i vjeter) — nxenesi mbetet AKTIV, thjesht s'numerohet me si "i ri" per asnje periudhe
  inactiveDate   DateTime?
  leaveReason       String?   // Arsyeja e largimit (kur behet INACTIVE)
  destinationSchool String?   // Shkolla ku kaloi nxenesi pas largimit
  hideFromDeparted  Boolean   @default(false) // Hequr manualisht nga karta "Largime/Transfere" — statusi INACTIVE i nxenesit NUK ndryshon, thjesht s'numerohet me si "i larguar" per asnje periudhe
  notes          String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  yearHistory    StudentYearHistory[]
  smsMessages    SmsMessage[]
  studentNotes   StudentNote[]
  evidenca       StudentEvidenca[]
  familyEmailLogs FamilyEmailLog[]
  documentEmailLogs DocumentEmailLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([classId])
  @@index([parentPhone])
  @@index([fatherPhone])
  @@index([motherPhone])
}

// ── Aplikimi Publik i Regjistrimit ("/apliko") ──────────────
// Plotësohet nga prindi/kujdestari PA kyçje (shih src/app/apliko), jo nga
// administrata. Krijohet fillimisht DRAFT (ndërsa prindi ende plotëson),
// pastaj PENDING pas dorëzimit ("Për Shqyrtim"). Shqyrtohet te "Regjistrimet"
// (src/app/(dashboard)/regjistrimet) — Prano krijon Student-in real (shih
// createdStudentId), Refuzo thjesht e mbyll aplikimin. NEEDS_INFO mbetet i
// rezervuar (jo ende i përdorur nga UI-ja e shqyrtimit).
model EnrollmentApplication {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])

  resumeToken     String    @unique // "bileta" sekrete e prindit — pa sesion/kyçje, kjo autorizon leximin/editimin/dorëzimin e vetë aplikimit të tij
  status          String    @default("DRAFT") // DRAFT, PENDING (aktive tani) | APPROVED, REJECTED, NEEDS_INFO (rezervuar)
  referenceNumber String?   @unique // p.sh. "APL-2026-0001" — plotësohet vetëm në dorëzim (submit), njësoj si numri i faturave

  // Shkolla/klasa — prindi zgjedh vetëm KLASËN/NUMRIN (p.sh. "6", jo "6A"/"6B");
  // ndarjen konkrete në një paralele (seksion) e bën administrata te "Prano"
  // (shih classId më poshtë, i mbushur vetëm në atë moment).
  schoolYear      String
  desiredGrade    Int?
  classId         Int?      // paralelja konkrete e caktuar nga administrata në pranim — bosh derisa të pranohet
  class           Class?    @relation(fields: [classId], references: [id])
  previousSchool  String?
  lastCompletedGrade String?
  desiredStartDate   DateTime?
  applicationReason  String?
  waitlisted      Boolean   @default(false) // prindi ka pranuar të vazhdojë aplikimin edhe pse klasa ishte plot

  // Nxënësi
  firstName       String
  lastName        String
  birthDate       DateTime?
  gender          String?
  personalNumber  String?
  citizenship     String?
  birthCountry    String?
  originType      String?   // "KOSOVE" | "DIASPORA"
  originCountry   String?   // plotësohet vetëm kur originType = DIASPORA

  // Nëna
  motherName      String?
  motherBirth     DateTime?
  motherProf      String?
  motherPhone     String?
  motherEmail     String?
  motherAddress   String?

  // Babai
  fatherName      String?
  fatherBirth     DateTime?
  fatherProf      String?
  fatherPhone     String?
  fatherEmail     String?
  fatherAddress   String?

  // Kujdestari / kontakti kryesor
  primaryContact       String? // "MOTHER" | "FATHER" | "OTHER"
  guardianOtherName     String?
  guardianOtherRelation String?
  guardianOtherPhone    String?
  guardianOtherEmail    String?

  // Adresa
  address         String?
  city            String?
  country         String?

  // Kontakti emergjent
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  additionalInfo  String?
  customAnswers   String?   // JSON string { [EnrollmentFormField.id]: përgjigja } — SQLite s'mbështet Json native, ruhet si tekst (shih lib/enrollmentFieldConfig.ts)

  // Pëlqimi + dorëzimi
  consentDataAccurate Boolean @default(false)
  submitterIp     String?   // vetëm për kufizim të thjeshtë spam-i (numërim ditor për IP)
  submittedAt     DateTime?

  // Shqyrtimi nga administrata (Regjistrimet)
  reviewedAt      DateTime?
  reviewNote      String?   // p.sh. arsyeja e refuzimit
  createdStudentId Int?     // Student i krijuar kur u pranua — pa relacion Prisma të detyruar, njësoj si BookSale/UniSale.studentId

  documents       ApplicationDocument[]
  evidenca        ApplicationEvidenca[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([submitterIp, createdAt])
}

// Evidenca e plotësuar PARA se aplikuesi të bëhet nxënës real — kur aplikimi
// pranohet (shih approve/route.ts), këto rreshta migrohen te StudentEvidenca
// e Student-it të sapokrijuar dhe fshihen këtu, që historiku i nxënësit ta
// ketë që nga fillimi (shih diskutimin me admin-in, 2026-09-25).
model ApplicationEvidenca {
  id             Int          @id @default(autoincrement())
  applicationId  Int
  application    EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  answers        String       // JSON string, i njëjti format si StudentEvidenca.answers
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([applicationId])
}

model ApplicationDocument {
  id            Int       @id @default(autoincrement())
  applicationId Int
  application   EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docType       String    // BIRTH_CERT | PARENT_ID | TRANSFER_DOC | VACCINATION_BOOK | MEDICAL_REPORT | OTHER
  fileName      String    // emri i ruajtur në disk (hex + ekstension)
  originalName  String
  contentType   String
  size          Int
  createdAt     DateTime  @default(now())

  @@index([applicationId])
}

// Pyetje shtesë të konfigurueshme nga administrata për "/apliko" (shih
// Cilësimet → "Formulari i Aplikimit") — çdo aplikim i ri i sheh vetëm ato
// aktive; `active:false` (fshirje e butë) mban etiketën për aplikimet e
// vjetra që tashmë kanë përgjigje te EnrollmentApplication.customAnswers.
model EnrollmentFormField {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  key            String   @unique // slug i gjeneruar nga etiketa, p.sh. "a-ka-nevoja-te-vecanta"
  label          String
  type           String   // TEXT | TEXTAREA | NUMBER | SELECT | CHECKBOX
  options        String?  // JSON string (array stringjesh) — vetëm për SELECT
  required       Boolean  @default(false)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active, order])
}

model PaymentCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  type           String       @default("monthly")
  defaultAmount  Float        @default(0)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  expenses       Expense[]
  prices         PaymentCategoryPrice[]
  handovers      PaymentHandover[]
  createdAt      DateTime     @default(now())
}

// Dorëzim parash për kategoritë e Payment-it (Shkollimi, Ushqimi, Eshkollori,
// etj) — regjistër i thjeshtë, i pavarur nga pagesat konkrete, njësoj si
// UniHandover/BookHandover (shih ato më poshtë) por i lidhur opsionalisht me
// një PaymentCategory, që administrata të dijë sa është dorëzuar nga secila.
// `categoryId` null = dorëzim i përgjithshëm, jo i lidhur me një kategori të vetme.
model PaymentHandover {
  id             Int              @id @default(autoincrement())
  categoryId     Int?
  category       PaymentCategory? @relation(fields: [categoryId], references: [id])
  amount         Float
  description    String?
  recipient      String?
  method         String           @default("CASH")
  reference      String?
  handoverAt     DateTime         @default(now())
  organizationId Int              @default(1)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([categoryId])
  @@index([handoverAt])
}

// ── Vitet Shkollore ───────────────────────────────────────

model SchoolYear {
  id             Int      @id @default(autoincrement())
  label          String   // "2026-2027"
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean  @default(false)
  organizationId Int      @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  prices         PaymentCategoryPrice[]
  studentHistory StudentYearHistory[]
  promotions     PromotionRun[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, label])
  @@index([organizationId, active])
}

model PaymentCategoryPrice {
  id            Int             @id @default(autoincrement())
  categoryId    Int
  category      PaymentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schoolYearId  Int
  schoolYear    SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  defaultAmount Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([categoryId, schoolYearId])
  @@index([schoolYearId])
}

// Foto e ngrirë e gjendjes së nxënësit PARA çdo kalimi viti — s'lidhet live
// me Class (mund të riemërtohet/fshihet më vonë), prandaj ruan tekst të ngrirë.
model StudentYearHistory {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  classId      Int?       // referencë e thjeshtë, pa @relation — s'bllokon fshirjen e Class
  className    String?
  classLevel   String?
  discountPct  Float      @default(0)
  status       String     // ACTIVE/INACTIVE në kohën e arkivimit
  studentName  String
  outcome      String     // PROMOTED | REPEATED | GRADUATED | LEFT
  newClassId   Int?
  newClassName String?
  createdAt    DateTime   @default(now())

  @@unique([studentId, schoolYearId])
  @@index([schoolYearId])
}

// Ditar/shënime manuale për nxënësin — plotësuar nga stafi me kalimin e kohës
// (progres, sjellje, komunikim me prindër). I PAVARUR nga AuditLog (i cili
// regjistron veprime automatike të sistemit) — këtu shkruan njeriu vetë.
model StudentNote {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content        String
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([studentId])
}

// Evidenca e regjistrimit — vlerësimi pedagogjik (tabelë aftësish me notë
// 5/4/3/2) + pyetësori shëndetësor/logjistik, plotësohet nga pedagogia pas
// takimit me nxënësin e sapopranuar. Kategoritë/pikat janë të konfigurueshme
// nga Cilësimet — shih EvidencaCategory/EvidencaItem më poshtë.
model EvidencaCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  label          String
  order          Int      @default(0)
  active         Boolean  @default(true)
  items          EvidencaItem[]
}

model EvidencaItem {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  section        String   // SKILLS (nën kategori, notë 5/4/3/2) | GENERAL (shëndetësor/logjistik)
  categoryId     Int?
  category       EvidencaCategory? @relation(fields: [categoryId], references: [id])
  label          String
  type           String   // RATING | YES_NO | CHOICE | TEXT | TEXTAREA
  options        String?  // JSON string (array) — vetëm për CHOICE
  hasSpecify     Boolean  @default(false) // vetëm për YES_NO — shton fushë "nëse PO, specifikoni"
  order          Int      @default(0)
  active         Boolean  @default(true) // fshirje e butë — përgjigjet e vjetra ruajnë etiketën
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentEvidenca {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        String       // JSON string: { [itemId]: vlera, [itemId+"__specify"]: tekst }
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([studentId])
}

model PromotionRun {
  id              Int        @id @default(autoincrement())
  fromYearId      Int?
  toYearId        Int
  toYear          SchoolYear @relation(fields: [toYearId], references: [id])
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  studentCount    Int
  promotedCount   Int
  repeatedCount   Int
  graduatedCount  Int
  leftCount       Int
  requestSnapshot String     // JSON e vendimeve të aplikuara
  createdAt       DateTime   @default(now())

  @@index([toYearId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    PaymentCategory @relation(fields: [categoryId], references: [id])
  type        String          // "EXPENSE" | "HANDOVER"
  amount      Float
  description String?
  recipient   String?
  date        DateTime        @default(now())
  method      String?
  reference   String?
  month       Int?
  year        Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Sipartner {
  id        Int      @id @default(autoincrement())
  emri      String
  nrFiskal  String?
  adresa    String?
  telefoni  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materials      Material[]
  materialOrders MaterialOrder[]

  @@index([emri])
}

model ShpenzimKategori {
  id        Int        @id @default(autoincrement())
  emri      String
  ngjyra    String?    // hex color, p.sh. "#ef4444"
  ikona     String?    // emoji ose emër ikone
  shpenzime Shpenzim[]
  createdAt DateTime   @default(now())
}

model Shpenzim {
  id         Int              @id @default(autoincrement())
  kategoriId Int
  kategori   ShpenzimKategori @relation(fields: [kategoriId], references: [id])
  shuma      Float
  pershkrim  String?
  marres     String?
  data       DateTime         @default(now())
  metoda     String?          // CASH, BANK, CARD
  referenca  String?
  docType      String           @default("KUPON") // KUPON, FATURE, OFERTE
  lloji        String           @default("ZYRE")  // ZYRE, BANKE
  paguar       Boolean          @default(true)     // true = paguar, false = borxh
  nrFature     String?          // numri i faturës
  emriBiznesit String?          // emri i biznesit/furnitorit
  nrFiskal     String?          // numri fiskal i biznesit
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([kategoriId])
  @@index([data])
}

// Historik i veprimeve masive (bulk) mbi Shpenzim — lejon "Zhbëj" kur një
// ndryshim/fshirje masive aplikohet gabimisht mbi rreshta të gabuar.
model ShpenzimBulkAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "PATCH" ose "DELETE"
  snapshot  String   // JSON: gjendja e plotë e rreshtave përpara veprimit
  count     Int
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Kërkesa për material didaktik nga mësimdhënësit — regjistrohen nga vetë
// mësimdhënësi (rol "TEACHER"), shqyrtohen nga menaxhmenti (ADMIN/FINANCE).
// ── Moduli i Materialeve Didaktike ────────────────────────
//
// MaterialRequest mban ende fushat e vjetra "flat" (item/quantity/unit/
// subjectOrClass) — nxënëse për prapa-përputhshmëri gjatë kalimit te struktura
// e re (kërkesë + shumë artikuj, shih MaterialRequestItem). Ato do të hiqen
// vetëm pasi çdo kod lexues/shkrues të kalojë te `items[]`, jo tani — shih
// scripts/migrate-material-requests.ts dhe planin e migrimit.
model MaterialRequest {
  id             Int          @id @default(autoincrement())
  teacherId      Int
  teacher        User         @relation("MaterialRequestTeacher", fields: [teacherId], references: [id])
  // Fusha të vjetra (nga struktura flat "1 kërkesë = 1 artikull") — lihen si
  // opsionale (jo hequr) që rreshtat historikë të mos humbin të dhëna; që nga
  // Faza 3 çdo kërkesë e re përdor items[] në vend të tyre.
  item           String?
  quantity       Int?
  unit           String?      // copë, metër, kg, litër, paketë
  subjectOrClass String?
  reason         String
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED — do të zgjerohet te statuset e reja pasi kodi konsumues të kalojë te items[]
  reviewedById   Int?
  reviewedBy     User?        @relation("MaterialRequestReviewer", fields: [reviewedById], references: [id])
  reviewNote     String?
  reviewedAt     DateTime?
  sentAt         DateTime?    // kur i-u dërgua email personit të blerjeve (FurnitoriOra)
  sentToEmail    String?
  sentSmsAt      DateTime?    // kur i-u dërgua SMS personit të blerjeve (FurnitoriOra) — vepron pavarësisht nga email-i
  sentToPhone    String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Fusha të reja (nullable — shtim aditiv, s'prek rreshtat ekzistues)
  priority       String?      // NORMAL, IMPORTANT, URGENT
  dateNeeded     DateTime?
  classId        Int?
  class          Class?       @relation(fields: [classId], references: [id])
  subjectId      Int?
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  comment        String?
  submittedAt    DateTime?

  items          MaterialRequestItem[]
  statusHistory  MaterialRequestStatusHistory[]

  @@index([status])
  @@index([teacherId])
}

model MaterialCategory {
  id             Int          @id @default(autoincrement())
  name           String
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  materials      Material[]
  customRequestItems MaterialRequestItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Subject {
  id             Int          @id @default(autoincrement())
  name           String
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  requests       MaterialRequest[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Material {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  categoryId     Int
  category       MaterialCategory @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  defaultUnit    String       @default("copë")
  needsColor     Boolean      @default(false)
  sku            String?
  supplierId     Int?
  supplier       Sipartner?   @relation(fields: [supplierId], references: [id])
  defaultPrice   Float?
  minStock       Int          @default(0)
  maxStock       Int?
  currentStock   Int          @default(0)
  active         Boolean      @default(true)
  source         String       @default("CATALOG") // CATALOG, FROM_CUSTOM_REQUEST
  requestItems   MaterialRequestItem[]
  orderItems     MaterialOrderItem[]
  transactions   MaterialInventoryTransaction[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, categoryId])
}

model MaterialRequestItem {
  id                 Int              @id @default(autoincrement())
  requestId          Int
  request            MaterialRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId         Int?
  material           Material?        @relation(fields: [materialId], references: [id])
  isCustom           Boolean          @default(false)
  customItemName     String?
  customDescription  String?
  customCategoryId   Int?
  customCategory     MaterialCategory? @relation(fields: [customCategoryId], references: [id])
  productLink        String?          // vetëm artikull i veçantë
  attachmentPath     String?          // vetëm artikull i veçantë
  quantity           Int
  unit               String
  color              String?
  itemReason         String?          // mbivendos arsyen e përbashkët të kërkesës, opsionale
  status             String           @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedQuantity   Int?
  approvalNote       String?
  addedToCatalogAsId Int?             // vendoset kur admini e shton artikullin e veçantë në katalog
  orderLinks         MaterialOrderRequestItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([requestId])
  @@index([materialId])
}

model MaterialRequestStatusHistory {
  id          Int             @id @default(autoincrement())
  requestId   Int
  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById Int
  changedBy   User            @relation("MaterialRequestStatusChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime        @default(now())

  @@index([requestId])
}

model MaterialOrder {
  id                   Int          @id @default(autoincrement())
  organizationId       Int          @default(1)
  organization         Organization @relation(fields: [organizationId], references: [id])
  orderNumber          String       @unique // "MAT-{vit}-{sekuencë}"
  supplierId           Int?
  supplier             Sipartner?   @relation(fields: [supplierId], references: [id])
  status               String       @default("DRAFT") // DRAFT, PENDING, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  orderDate            DateTime     @default(now())
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  notes                String?
  totalItems           Int          @default(0)
  totalQuantity        Int          @default(0)
  estimatedCost        Float        @default(0)
  actualCost           Float        @default(0)
  createdById          Int
  createdBy            User         @relation(fields: [createdById], references: [id])
  items                MaterialOrderItem[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, status])
}

model MaterialOrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int
  order            MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId       Int?
  material         Material?     @relation(fields: [materialId], references: [id])
  customItemName   String?       // rezervë nëse artikulli s'është premtuar ende në katalog
  color            String?       // artikujt me ngjyra të ndryshme grupohen në rreshta të ndarë
  unit             String
  quantity         Int           // sasia e porositur
  unitPrice        Float?
  totalPrice       Float?
  receivedQuantity Int           @default(0)
  receivedAt       DateTime?
  receiveNotes     String?
  requestLinks     MaterialOrderRequestItem[]
  transactions     MaterialInventoryTransaction[]

  @@index([orderId])
}

// Lidh një rresht porosie me disa kërkesa/artikuj individualë njëkohësisht
// (p.sh. "7 mësimdhënëse kërkuan marker = 63 copë" grupuar në një rresht porosie).
model MaterialOrderRequestItem {
  id                  Int                 @id @default(autoincrement())
  orderItemId         Int
  orderItem           MaterialOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  requestItemId       Int
  requestItem         MaterialRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  quantityContributed Int

  @@unique([orderItemId, requestItemId])
  @@index([requestItemId])
}

model MaterialInventoryTransaction {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  materialId     Int
  material       Material     @relation(fields: [materialId], references: [id])
  type           String       // RECEIVED, ADJUSTMENT
  quantity       Int          // e nënshkruar (+/-)
  balanceAfter   Int
  orderItemId    Int?
  orderItem      MaterialOrderItem? @relation(fields: [orderItemId], references: [id])
  note           String?
  createdById    Int
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, materialId])
}

model Payment {
  id            Int              @id @default(autoincrement())
  studentId     Int
  student       Student          @relation(fields: [studentId], references: [id])
  categoryId    Int
  category      PaymentCategory  @relation(fields: [categoryId], references: [id])
  amount        Float
  discount      Float            @default(0)
  discountType  String?          // percentage, fixed
  scholarship   Float            @default(0)
  finalAmount   Float
  dueDate       DateTime
  paidDate      DateTime?
  paidAmount    Float            @default(0)
  balance       Float            @default(0)
  method        String?          // CASH, BANK, CARD, ONLINE
  status        String           @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  description   String?
  note          String?          // shënim i lirë i stafit (p.sh. "borxh i vjetër nga 2025-2026")
  invoiceId     Int?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  month         Int?             // 1-12 for monthly payments
  year          Int?
  receiptNumber  String?          @unique
  familyReceiptId Int?            // grupon disa Payment (nga fëmijë të ndryshëm të së njëjtës familje)
  familyReceipt   FamilyReceipt?  @relation(fields: [familyReceiptId], references: [id])
  // "Konfirmuar" = shuma e paguar konsiderohet e vërtetuar si e hyrë reale.
  // @default(true) — pagesat ekzistuese (futur me dorë deri tani) mbeten të
  // konfirmuara automatikisht. false vetëm kur krijohet nga import Excel (çdo
  // kategori) ose kur është pagesë Shkollimi për nxënës të lidhur me TIMI
  // Invest (shih POST /api/payments dhe /api/payments/import) — deri sa
  // dikush ta shqyrtojë manualisht te "Shkollimi → Verifikim".
  confirmed      Boolean          @default(true)
  organizationId Int              @default(1)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([familyReceiptId])
}

// Grupon disa pagesa (Payment) nga fëmijë të ndryshëm të së njëjtës familje, të regjistruara
// dhe të paguara njëkohësisht, në një dëshmi/fletëpagesë të vetme të printueshme — çdo Payment
// mbetet i lidhur individualisht me nxënësin e tij (gjurma financiare e secilit qëndron e saktë),
// vetëm printimi/faturimi i shfaqet stafit si një dokument i vetëm.
model FamilyReceipt {
  id             Int          @id @default(autoincrement())
  receiptNumber  String       @unique  // FAM-{vit}-{sekuencë}
  parentName     String?
  parentPhone    String?
  method         String?      // CASH, BANK, CARD, ONLINE
  totalAmount    Float        @default(0)
  paidDate       DateTime     @default(now())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  uniSales       UniSale[]
  bookSales      BookSale[]
  createdAt      DateTime     @default(now())
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  type        String        // INVOICE, PROFORMA, OFFER
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id])
  items       InvoiceItem[]
  subtotal    Float
  vatRate     Float         @default(0)
  vatAmount   Float         @default(0)
  total       Float
  status      String        @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  convertedInvoiceId Int?   // kur type=PROFORMA dhe eshte konvertuar, id e Invoice-it real te krijuar
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model InvoiceItem {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Cili fëmijë i përket ky zë — opsionale, që një faturë e vetme e prindit
  // të mund të mbulojë disa fëmijë (secili zë me nxënësin e vet). Bosh =
  // zë i përgjithshëm/i përbashkët, jo i lidhur me një fëmijë specifik.
  studentId     Int?
  student       Student? @relation(fields: [studentId], references: [id])
  description   String
  quantity      Float    @default(1)
  regularPrice  Float    @default(0)
  discountPct   Float    @default(0)
  unitPrice     Float
  total         Float

  @@index([studentId])
}

// ── Sistemi i Uniformave ──────────────────────────────────

model UniProduct {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  buyPrice    Float
  sellPrice   Float
  stock       Int            @default(0)
  stockAlert  Int            @default(5)
  active      Boolean        @default(true)
  saleItems   UniSaleItem[]
  orderItems  UniOrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model UniOrder {
  id           Int            @id @default(autoincrement())
  orderNumber  String         @unique
  supplier     String?
  status       String         @default("ORDERED") // ORDERED, RECEIVED, CANCELLED
  orderDate    DateTime       @default(now())
  receivedDate DateTime?
  notes        String?
  items        UniOrderItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UniOrderItem {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     UniOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   UniProduct @relation(fields: [productId], references: [id])
  quantity  Int
  buyPrice  Float
  total     Float
}

model UniSale {
  id            Int           @id @default(autoincrement())
  studentId     Int?
  customerName  String
  customerPhone String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float         @default(0)
  balance       Float         @default(0)
  status        String        @default("PENDING")
  saleDate      DateTime      @default(now())
  notes         String?
  items         UniSaleItem[]
  payments      UniPayment[]
  familyReceiptId Int?        // bashkuar në një dëshmi pagese familjeje me shitje të tjera
  familyReceipt   FamilyReceipt? @relation(fields: [familyReceiptId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([familyReceiptId])
}

model UniSaleItem {
  id        Int        @id @default(autoincrement())
  saleId    Int
  sale      UniSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   UniProduct @relation(fields: [productId], references: [id])
  size      String?
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model UniPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      UniSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model UniHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  recipient   String?
  method      String   @default("CASH")
  handoverAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
}

// ── Librat e Anglishtes ───────────────────────────────────

model BookProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  buyPrice    Float
  sellPrice   Float
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookSale {
  id            Int      @id @default(autoincrement())
  studentId     Int?
  studentName   String
  studentClass  String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float    @default(0)
  balance       Float    @default(0)
  status        String   @default("PENDING")
  receiptNumber String?
  saleDate      DateTime @default(now())
  notes         String?
  familyReceiptId Int?   // bashkuar në një dëshmi pagese familjeje me shitje të tjera
  familyReceipt   FamilyReceipt? @relation(fields: [familyReceiptId], references: [id])
  sentSmsAt     DateTime? // kur i-u dërgua SMS kujtese borxhi prindit (butoni te lista e shitjeve)
  sentToPhone   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyReceiptId])
}

model BookSaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model BookPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model BookHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  recipient   String?
  method      String   @default("CASH")
  handoverAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Student, Payment, Invoice, etc.
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ── SMS ───────────────────────────────────────────────────
// Regjistër i çdo SMS-i të dërguar përmes gateway-t (RBSoft SMS Gateway apo
// çfarëdo tjetër që ekspozon një API të ngjashme) — një rresht për marrës,
// edhe kur dërgimi është "në grup" (bashkuar nën të njëjtin batchId që të
// duket si një veprim i vetëm në histori).
model SmsMessage {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  batchId        String?      // grupon dërgimet "në grup" (klasë/familje/shumë të zgjedhur)
  recipientPhone String
  recipientName  String?
  studentId      Int?
  student        Student?     @relation(fields: [studentId], references: [id])
  message        String
  status         String       @default("PENDING") // PENDING, SENT, FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User         @relation(fields: [sentById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([batchId])
  @@index([studentId])
}

// Log i dërgimeve email nga karta e Familjes ("Buton Email") — mesazh i lirë
// (subjekt+tekst), jo email transaksional. Mirror i SmsMessage.
model FamilyEmailLog {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  batchId        String?
  recipientEmail String
  recipientName  String?
  studentId      Int?
  student        Student?     @relation(fields: [studentId], references: [id])
  subject        String
  message        String
  status         String       // SENT | FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User         @relation(fields: [sentById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([batchId])
  @@index([studentId])
}

// Bibliotekë dokumentesh të përgjithshme të shkollës (katalogë, broshura,
// rregullore, etj.) — të ngarkueshme nga Administrata, me mundësi dërgimi
// me email te prindërit. Skedari ruhet në disk (si material-attachments),
// jo në databazë.
model SchoolDocument {
  id               Int          @id @default(autoincrement())
  organizationId   Int          @default(1)
  organization     Organization @relation(fields: [organizationId], references: [id])
  title            String
  description      String?
  category         String?
  fileName         String       // emri i ruajtur në disk (UUID+ext)
  originalFileName String
  mimeType         String
  size             Int
  uploadedById     Int
  uploadedBy       User         @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime     @default(now())
  emailLogs        DocumentEmailLog[]

  @@index([organizationId, category])
}

model DocumentEmailLog {
  id             Int            @id @default(autoincrement())
  documentId     Int
  document       SchoolDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  batchId        String?
  recipientEmail String
  recipientName  String?
  studentId      Int?
  student        Student?       @relation(fields: [studentId], references: [id])
  status         String         // SENT | FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User           @relation(fields: [sentById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([documentId])
  @@index([batchId])
}

// ── TIMI INVEST ───────────────────────────────────────────

model TimiInvestStudent {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  parentName   String
  parentPhone  String
  regularPrice    Float
  discountPct     Float    @default(0)
  manualDiscAmt   Float    @default(0)
  studentId    Int?     // lidhje me Student.id kryesor (opsionale)
  active       Boolean  @default(true)
  stage        String   @default("PROFATURE") // PROFATURE | NE_PROCES | KRYER — pipeline i klientit, i ndarë nga `active` (arkivim)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TimiInvestInvoice {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  seq              Int
  month            Int
  year             Int
  parentName       String
  date             DateTime @default(now())
  items            String   // JSON: [{name, regularPrice, discountPct, finalAmount}]
  timiStudentIds   String?  // JSON: [TimiInvestStudent.id, ...] — lidhje e qëndrueshme me fëmijët
  totalAmount      Float
  timiDiscPct      Float    @default(4.66)
  timiDiscAmt      Float
  finalAmount      Float
  notes            String?
  schoolYear       String?
  regularInvoiceId Int?     @unique // Invoice.id — nëse është konvertuar në faturë të rregullt
  createdAt        DateTime @default(now())
}

// ── Fletorja Digjitale e Adminit ──────────────────────────

model AdminNote {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String
  color     String   @default("slate") // slate, blue, yellow, green, red, purple, orange
  tags      String?  // comma-separated
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  assignedTo  String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminReminder {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   @default("GENERAL") // PAYMENT, MEETING, DOCUMENT, GENERAL
  dueDate     DateTime
  done        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("GENERAL") // EXAM, MEETING, ACTIVITY, HOLIDAY, GENERAL
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Stafi ─────────────────────────────────────────────────

model Staff {
  id          Int      @id @default(autoincrement())
  emri        String
  telefoni    String?
  lenda       String?
  nrPersonal  String?
  nrLlogarise String?
  banka       String?
  totalBruto  Float?
  kontrata        String?
  llojiKontrates  String?
  cmimOres        Float?
  oreMuaj         Int?
  adresa          String?
  kodi            String?
  tipi            String?
  status          String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Investim {
  id             Int      @id @default(autoincrement())
  tipi           String   // KAPITAL, PERKOHSHEM
  data           DateTime @default(now())
  pershkrim      String
  kategoria      String?
  vlera          Float
  metoda         String   @default("CASH") // CASH, BANK, CARD, TRANSFER
  dokumenti      String?
  regjistruarNga String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipi])
  @@index([data])
}

model Hyra {
  id        Int      @id @default(autoincrement())
  paguesit  String
  shuma     Float
  kategoria String   @default("SHKOLLIMI")
  muaj      Int
  vit       Int
  metoda    String?  // CASH, BANK
  referenca String?
  shenime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vit, muaj])
  @@index([paguesit])
}

model DocArchive {
  id          Int      @id @default(autoincrement())
  type        String   // FLETEKALIM_CL, FLETEKALIM_CU, PASQYRE_CU, VERTETIM_CL
  studentId   Int?
  studentName String
  className   String?
  data        String   // JSON: të gjitha fushat e modalit
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([studentId])
  @@index([createdAt])
}

model LibriAme {
  id            Int      @id @default(autoincrement())
  studentId     Int      @unique
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vendiLindjes  String?
  shteti        String?
  shtetas       String?
  komuna        String?
  adresaPrindit String?
  notat         String?  // JSON: grades Kl.6-9
  levizjet      String?  // JSON: page 2 Kl.6-9
  notatFillore  String?  // JSON: grades Kl.1-5
  levizjetFillore String? // JSON: page 2 Kl.1-5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
