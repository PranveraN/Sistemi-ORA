generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  active           Boolean           @default(true)
  plan             String            @default("trial") // trial, basic, pro
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  classes          Class[]
  students         Student[]
  paymentCategories PaymentCategory[]
  payments         Payment[]
  invoices         Invoice[]
  schoolYears      SchoolYear[]
  materialRequests MaterialRequest[]
  familyReceipts   FamilyReceipt[]
  materialCategories MaterialCategory[]
  subjects         Subject[]
  materials        Material[]
  materialOrders   MaterialOrder[]
  materialInventoryTransactions MaterialInventoryTransaction[]
  smsMessages      SmsMessage[]
  paymentHandovers PaymentHandover[]
  studentNotes     StudentNote[]
  enrollmentApplications EnrollmentApplication[]
  studentEvidenca  StudentEvidenca[]
  applicationEvidenca ApplicationEvidenca[]
  schoolDocuments  SchoolDocument[]
  familyEmailLogs  FamilyEmailLog[]
  gradeNineLeavers GradeNineLeaver[]
  roleModulePermissions RoleModulePermission[]
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  name           String
  password       String
  role           String       @default("SECRETARY") // ADMIN (shikim + shtim/ndryshim), FINANCE, SECRETARY, SUPERADMIN (qasje e plotë), TEACHER (portal i vet), PEDAGOGIA (module të konfigurueshme)
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  shpenzimBulkActions ShpenzimBulkAction[]
  promotionRuns  PromotionRun[]
  materialRequests         MaterialRequest[] @relation("MaterialRequestTeacher")
  reviewedMaterialRequests MaterialRequest[] @relation("MaterialRequestReviewer")
  materialRequestStatusChanges MaterialRequestStatusHistory[] @relation("MaterialRequestStatusChangedBy")
  createdMaterialOrders    MaterialOrder[]
  materialInventoryTransactions MaterialInventoryTransaction[]
  sentSmsMessages          SmsMessage[]
  studentNotes             StudentNote[]
  evidencaRecords          StudentEvidenca[]
  applicationEvidencaRecords ApplicationEvidenca[]
  uploadedDocuments        SchoolDocument[]
  documentsSent            DocumentEmailLog[]
  familyEmailsSent         FamilyEmailLog[]
  studentHistory           StudentHistory[]
  familyNotes              FamilyNote[]
}

model Class {
  id             Int          @id @default(autoincrement())
  name           String
  level          String
  teacher        String?
  capacity       Int?         // Numri max i nxënësve — bosh = pa limit (përdoret te aplikimi publik i regjistrimit, shih EnrollmentApplication)
  active         Boolean      @default(true) // A është kjo paralele e hapur/funksionale këtë vit — një paralele joaktive (p.sh. bosh, e pahapur) NUK numërohet si "vend i lirë" te kontrolli i kapacitetit
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  students       Student[]
  materialRequests MaterialRequest[]
  enrollmentApplications EnrollmentApplication[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Student {
  id             Int       @id @default(autoincrement())
  firstName      String
  lastName       String
  parentName     String?
  birthDate      DateTime?
  personalNumber String?
  gender         String?
  classId        Int?
  class          Class?    @relation(fields: [classId], references: [id])
  libriAme       LibriAme?
  familyId       String?   // FAM-001, FAM-002, etj.
  discountPct    Float     @default(0) // Zbritja % (vëlla/motër)
  guardian       String?
  motherNumber   String?
  diaryNumber    String?
  parentPhone    String?
  address        String?
  // Mother
  motherName     String?
  motherBirth    DateTime?
  motherProf     String?
  motherPhone    String?
  motherEmail    String?
  // Father
  fatherName     String?
  fatherBirth    DateTime?
  fatherProf     String?
  fatherPhone    String?
  fatherEmail    String?
  kontrata       String?   // Po, Nuk e ka kthy, Nuk ka
  paymentPlan    String?   // FULL, TWO, MONTHLY, TIMI_INVEST — synimi/regjistrimi i menyres se pageses
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  enrollDate     DateTime  @default(now())
  originCountry  String?   // Vendi nga ka ardhur (kur eshte nxenes i ardhur nga jashte Kosoves)
  previousSchool String?   // Shkolla paraardhese (nga ka ardhur nxenesi)
  transferResult String?   // Suksesi/rezultati i fletekalimit nga shkolla paraardhese
  admissionScore Float?    // Piket ne testin pranues "Ora"
  studentRating  String?   // Vleresim i mesuesve — etikete fikse (shih STUDENT_RATINGS)
  hideFromNewRegistrations Boolean @default(false) // Hequr manualisht nga karta "Nxenes te Rinj" (p.sh. enrollDate gabim nga nje import i vjeter) — nxenesi mbetet AKTIV, thjesht s'numerohet me si "i ri" per asnje periudhe
  inactiveDate   DateTime?
  leaveReason       String?   // Arsyeja e largimit (kur behet INACTIVE)
  destinationSchool String?   // Shkolla ku kaloi nxenesi pas largimit
  hideFromDeparted  Boolean   @default(false) // Hequr manualisht nga karta "Largime/Transfere" — statusi INACTIVE i nxenesit NUK ndryshon, thjesht s'numerohet me si "i larguar" per asnje periudhe
  notes          String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  invoices       Invoice[]
  invoiceItems   InvoiceItem[]
  yearHistory    StudentYearHistory[]
  smsMessages    SmsMessage[]
  studentNotes   StudentNote[]
  evidenca       StudentEvidenca[]
  familyEmailLogs FamilyEmailLog[]
  documentEmailLogs DocumentEmailLog[]
  history        StudentHistory[]
  specialCare    StudentSpecialCare[]
  familyRefId    Int?      // → Family (shtuar 2026-10; "familyId" tekst i vjetër s'preket)
  family         Family?   @relation(fields: [familyRefId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([status])
  @@index([classId])
  @@index([parentPhone])
  @@index([fatherPhone])
  @@index([motherPhone])
}

// ── Aplikimi Publik i Regjistrimit ("/apliko") ──────────────
// Plotësohet nga prindi/kujdestari PA kyçje (shih src/app/apliko), jo nga
// administrata. Krijohet fillimisht DRAFT (ndërsa prindi ende plotëson),
// pastaj PENDING pas dorëzimit ("Për Shqyrtim"). Shqyrtohet te "Regjistrimet"
// (src/app/(dashboard)/regjistrimet) — Prano krijon Student-in real (shih
// createdStudentId), Refuzo thjesht e mbyll aplikimin. NEEDS_INFO mbetet i
// rezervuar (jo ende i përdorur nga UI-ja e shqyrtimit).
model EnrollmentApplication {
  id              Int       @id @default(autoincrement())
  organizationId  Int       @default(1)
  organization    Organization @relation(fields: [organizationId], references: [id])

  resumeToken     String    @unique // "bileta" sekrete e prindit — pa sesion/kyçje, kjo autorizon leximin/editimin/dorëzimin e vetë aplikimit të tij
  status          String    @default("DRAFT") // DRAFT, PENDING (aktive tani) | APPROVED, REJECTED, NEEDS_INFO (rezervuar)
  referenceNumber String?   @unique // p.sh. "APL-2026-0001" — plotësohet vetëm në dorëzim (submit), njësoj si numri i faturave

  // Shkolla/klasa — prindi zgjedh vetëm KLASËN/NUMRIN (p.sh. "6", jo "6A"/"6B");
  // ndarjen konkrete në një paralele (seksion) e bën administrata te "Prano"
  // (shih classId më poshtë, i mbushur vetëm në atë moment).
  schoolYear      String
  desiredGrade    Int?
  classId         Int?      // paralelja konkrete e caktuar nga administrata në pranim — bosh derisa të pranohet
  class           Class?    @relation(fields: [classId], references: [id])
  previousSchool  String?
  lastCompletedGrade String?
  desiredStartDate   DateTime?
  applicationReason  String?
  waitlisted      Boolean   @default(false) // prindi ka pranuar të vazhdojë aplikimin edhe pse klasa ishte plot

  // Nxënësi
  firstName       String
  lastName        String
  birthDate       DateTime?
  gender          String?
  personalNumber  String?
  citizenship     String?
  birthCountry    String?
  originType      String?   // "KOSOVE" | "DIASPORA"
  originCountry   String?   // plotësohet vetëm kur originType = DIASPORA

  // Nëna
  motherName      String?
  motherBirth     DateTime?
  motherProf      String?
  motherPhone     String?
  motherEmail     String?
  motherAddress   String?

  // Babai
  fatherName      String?
  fatherBirth     DateTime?
  fatherProf      String?
  fatherPhone     String?
  fatherEmail     String?
  fatherAddress   String?

  // Kujdestari / kontakti kryesor
  primaryContact       String? // "MOTHER" | "FATHER" | "OTHER"
  guardianOtherName     String?
  guardianOtherRelation String?
  guardianOtherPhone    String?
  guardianOtherEmail    String?

  // Adresa
  address         String?
  city            String?
  country         String?

  // Kontakti emergjent
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  additionalInfo  String?
  customAnswers   String?   // JSON string { [EnrollmentFormField.id]: përgjigja } — SQLite s'mbështet Json native, ruhet si tekst (shih lib/enrollmentFieldConfig.ts)

  // Pëlqimi + dorëzimi
  consentDataAccurate Boolean @default(false)
  submitterIp     String?   // vetëm për kufizim të thjeshtë spam-i (numërim ditor për IP)
  submittedAt     DateTime?

  // Shqyrtimi nga administrata (Regjistrimet)
  reviewedAt      DateTime?
  reviewNote      String?   // p.sh. arsyeja e refuzimit
  createdStudentId Int?     // Student i krijuar kur u pranua — pa relacion Prisma të detyruar, njësoj si BookSale/UniSale.studentId
  // Rrjedha e re (shtuar 2026-10): Për shqyrtim → (Evidenca) → Pranuar / Refuzuar
  evidencaState   String?   // IN_PROGRESS | DONE | REQUIRED | NOT_REQUIRED — null = llogaritet nga rregulli (src/lib/enrollmentRules.ts)
  rejectReason    String?   // kodi i arsyes (lista te enrollmentRules.ts); teksti i lirë mbetet te reviewNote
  source          String?   // ONLINE | OFFICE
  statusHistory   ApplicationStatusHistory[]

  documents       ApplicationDocument[]
  evidenca        ApplicationEvidenca[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([submitterIp, createdAt])
}

// Evidenca e plotësuar PARA se aplikuesi të bëhet nxënës real — kur aplikimi
// pranohet (shih approve/route.ts), këto rreshta migrohen te StudentEvidenca
// e Student-it të sapokrijuar dhe fshihen këtu, që historiku i nxënësit ta
// ketë që nga fillimi (shih diskutimin me admin-in, 2026-09-25).
model ApplicationEvidenca {
  id             Int          @id @default(autoincrement())
  applicationId  Int
  application    EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  answers        String       // JSON string, i njëjti format si StudentEvidenca.answers
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([applicationId])
}

model ApplicationDocument {
  id            Int       @id @default(autoincrement())
  applicationId Int
  application   EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docType       String    // BIRTH_CERT | PARENT_ID | TRANSFER_DOC | VACCINATION_BOOK | MEDICAL_REPORT | OTHER
  fileName      String    // emri i ruajtur në disk (hex + ekstension)
  originalName  String
  contentType   String
  size          Int
  createdAt     DateTime  @default(now())

  @@index([applicationId])
}

// Pyetje shtesë të konfigurueshme nga administrata për "/apliko" (shih
// Cilësimet → "Formulari i Aplikimit") — çdo aplikim i ri i sheh vetëm ato
// aktive; `active:false` (fshirje e butë) mban etiketën për aplikimet e
// vjetra që tashmë kanë përgjigje te EnrollmentApplication.customAnswers.
model EnrollmentFormField {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  key            String   @unique // slug i gjeneruar nga etiketa, p.sh. "a-ka-nevoja-te-vecanta"
  label          String
  type           String   // TEXT | TEXTAREA | NUMBER | SELECT | CHECKBOX
  options        String?  // JSON string (array stringjesh) — vetëm për SELECT
  required       Boolean  @default(false)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, active, order])
}

model PaymentCategory {
  id             Int          @id @default(autoincrement())
  name           String
  description    String?
  type           String       @default("monthly")
  defaultAmount  Float        @default(0)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  expenses       Expense[]
  prices         PaymentCategoryPrice[]
  handovers      PaymentHandover[]
  createdAt      DateTime     @default(now())
}

// Dorëzim parash për kategoritë e Payment-it (Shkollimi, Ushqimi, Eshkollori,
// etj) — regjistër i thjeshtë, i pavarur nga pagesat konkrete, njësoj si
// UniHandover/BookHandover (shih ato më poshtë) por i lidhur opsionalisht me
// një PaymentCategory, që administrata të dijë sa është dorëzuar nga secila.
// `categoryId` null = dorëzim i përgjithshëm, jo i lidhur me një kategori të vetme.
model PaymentHandover {
  id             Int              @id @default(autoincrement())
  categoryId     Int?
  category       PaymentCategory? @relation(fields: [categoryId], references: [id])
  amount         Float
  description    String?
  recipient      String?
  method         String           @default("CASH")
  reference      String?
  handoverAt     DateTime         @default(now())
  organizationId Int              @default(1)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([categoryId])
  @@index([handoverAt])
}

// ── Vitet Shkollore ───────────────────────────────────────

model SchoolYear {
  id             Int      @id @default(autoincrement())
  label          String   // "2026-2027"
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean  @default(false)
  organizationId Int      @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  prices         PaymentCategoryPrice[]
  studentHistory StudentYearHistory[]
  promotions     PromotionRun[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, label])
  @@index([organizationId, active])
}

model PaymentCategoryPrice {
  id            Int             @id @default(autoincrement())
  categoryId    Int
  category      PaymentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schoolYearId  Int
  schoolYear    SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  defaultAmount Float           @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([categoryId, schoolYearId])
  @@index([schoolYearId])
}

// Foto e ngrirë e gjendjes së nxënësit PARA çdo kalimi viti — s'lidhet live
// me Class (mund të riemërtohet/fshihet më vonë), prandaj ruan tekst të ngrirë.
model StudentYearHistory {
  id           Int        @id @default(autoincrement())
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id])
  schoolYearId Int
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  classId      Int?       // referencë e thjeshtë, pa @relation — s'bllokon fshirjen e Class
  className    String?
  classLevel   String?
  discountPct  Float      @default(0)
  status       String     // ACTIVE/INACTIVE në kohën e arkivimit
  studentName  String
  outcome      String     // PROMOTED | REPEATED | GRADUATED | LEFT
  newClassId   Int?
  newClassName String?
  createdAt    DateTime   @default(now())

  @@unique([studentId, schoolYearId])
  @@index([schoolYearId])
}

// Ditar/shënime manuale për nxënësin — plotësuar nga stafi me kalimin e kohës
// (progres, sjellje, komunikim me prindër). I PAVARUR nga AuditLog (i cili
// regjistron veprime automatike të sistemit) — këtu shkruan njeriu vetë.
model StudentNote {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content        String
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([studentId])
}

// Evidenca e regjistrimit — vlerësimi pedagogjik (tabelë aftësish me notë
// 5/4/3/2) + pyetësori shëndetësor/logjistik, plotësohet nga pedagogia pas
// takimit me nxënësin e sapopranuar. Kategoritë/pikat janë të konfigurueshme
// nga Cilësimet — shih EvidencaCategory/EvidencaItem më poshtë.
model EvidencaCategory {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  label          String
  order          Int      @default(0)
  active         Boolean  @default(true)
  items          EvidencaItem[]
}

model EvidencaItem {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  section        String   // SKILLS (nën kategori, notë 5/4/3/2) | GENERAL (shëndetësor/logjistik)
  categoryId     Int?
  category       EvidencaCategory? @relation(fields: [categoryId], references: [id])
  label          String
  type           String   // RATING | YES_NO | CHOICE | TEXT | TEXTAREA
  options        String?  // JSON string (array) — vetëm për CHOICE
  hasSpecify     Boolean  @default(false) // vetëm për YES_NO — shton fushë "nëse PO, specifikoni"
  order          Int      @default(0)
  active         Boolean  @default(true) // fshirje e butë — përgjigjet e vjetra ruajnë etiketën
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StudentEvidenca {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        String       // JSON string: { [itemId]: vlera, [itemId+"__specify"]: tekst }
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id])
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([studentId])
}

// Lista e thjeshtë manuale e nxënësve të Klasës së 9 që u diplomuan/u larguan
// një vit të kaluar (ose vit tjetër) — këta nxënës NUK janë (më) të regjistruar
// si Student në sistem, ndaj nuk mund të "gjenden" apo lidhen me një rresht real
// (shih src/app/(dashboard)/levizjet — karta "Klasa e 9"). Vetëm emër + klasë +
// viti, pa lidhje me Student.
model GradeNineLeaver {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  fullName       String
  className      String?
  year           Int
  yearType       String       @default("academic") // "academic" | "calendar" — njësoj si period-i i faqes Lëvizjet
  note           String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, year, yearType])
}

// Leje modulesh PËR ROL (jo për SUPERADMIN — gjithmonë qasje e plotë — as për
// TEACHER, që ka portalin e vet krejt të veçantë, /kerkesa-material, jashtë
// këtij sistemi modulesh). Mungesa e një rreshti për (role, moduleKey) do të
// thotë "përdor parazgjedhjen" (shih DEFAULT_ALLOWED te src/lib/modules.ts) —
// kështu instalimi ekzistues NUK ndryshon sjellje derisa dikush eksplicitisht
// të ndryshojë një leje nga faqja e re e administrimit.
model RoleModulePermission {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String
  moduleKey      String
  allowed        Boolean
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, role, moduleKey])
}

model PromotionRun {
  id              Int        @id @default(autoincrement())
  fromYearId      Int?
  toYearId        Int
  toYear          SchoolYear @relation(fields: [toYearId], references: [id])
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  studentCount    Int
  promotedCount   Int
  repeatedCount   Int
  graduatedCount  Int
  leftCount       Int
  requestSnapshot String     // JSON e vendimeve të aplikuara
  createdAt       DateTime   @default(now())

  @@index([toYearId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  categoryId  Int
  category    PaymentCategory @relation(fields: [categoryId], references: [id])
  type        String          // "EXPENSE" | "HANDOVER"
  amount      Float
  description String?
  recipient   String?
  date        DateTime        @default(now())
  method      String?
  reference   String?
  month       Int?
  year        Int?
  // Shpenzimet e Shkollimit u bartën te tabela Shpenzim — rreshti mbetet (arkiv), me lidhje te i riu
  migratedToShpenzimId Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Sipartner {
  id        Int      @id @default(autoincrement())
  emri      String
  nrFiskal  String?
  adresa    String?
  telefoni  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  materials      Material[]
  materialOrders MaterialOrder[]

  @@index([emri])
}

model ShpenzimKategori {
  id        Int        @id @default(autoincrement())
  emri      String
  ngjyra    String?    // hex color, p.sh. "#ef4444"
  ikona     String?    // emoji ose emër ikone
  // SHKOLLIMI (parazgjedhje) | USHQIMI — kategoritë e ushqimit s'zbriten nga arka e Shkollimit
  fusha     String     @default("SHKOLLIMI")
  shpenzime Shpenzim[]
  createdAt DateTime   @default(now())
}

model Shpenzim {
  id         Int              @id @default(autoincrement())
  kategoriId Int
  kategori   ShpenzimKategori @relation(fields: [kategoriId], references: [id])
  shuma      Float
  pershkrim  String?
  marres     String?
  data       DateTime         @default(now())
  metoda     String?          // CASH, BANK, CARD
  referenca  String?
  docType      String           @default("KUPON") // KUPON, FATURE, OFERTE
  lloji        String           @default("ZYRE")  // ZYRE, BANKE
  paguar       Boolean          @default(true)     // true = paguar, false = borxh
  nrFature     String?          // numri i faturës
  emriBiznesit String?          // emri i biznesit/furnitorit
  nrFiskal     String?          // numri fiskal i biznesit
  dataDokumentit DateTime?      // data e shkruar në faturë/kupon (`data` = data e regjistrimit/pagesës)
  // Pagesa pjesë-pjesë: true që nga pagesa e parë pjesore — atëherë fatura s'llogaritet
  // vetë si e paguar; llogariten vetëm pagesat e saj (ShpenzimPagese), secila në datën
  // dhe me metodën e vet. `paguar` mbahet në sinkron (true kur pagesat mbulojnë shumën).
  mePagesa      Boolean         @default(false)
  pagesat       ShpenzimPagese[]
  // Fshirje logjike: rreshti s'fshihet kurrë nga databaza, vetëm fshihet nga listat/totalet
  deletedAt     DateTime?
  deletedById   Int?
  deletedByName String?
  // Migrimi nga skeda e vjetër "Shpenzime" e Shkollimit (Expense) — siguron që s'krijohen dyfishime
  migratedFromExpenseId Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([kategoriId])
  @@index([data])
  @@index([deletedAt])
  @@index([migratedFromExpenseId])
}

// Historik i veprimeve masive (bulk) mbi Shpenzim — lejon "Zhbëj" kur një
// ndryshim/fshirje masive aplikohet gabimisht mbi rreshta të gabuar.
model ShpenzimBulkAction {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // "PATCH" ose "DELETE"
  snapshot  String   // JSON: gjendja e plotë e rreshtave përpara veprimit
  count     Int
  undone    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Kërkesa për material didaktik nga mësimdhënësit — regjistrohen nga vetë
// mësimdhënësi (rol "TEACHER"), shqyrtohen nga menaxhmenti (ADMIN/FINANCE).
// ── Moduli i Materialeve Didaktike ────────────────────────
//
// MaterialRequest mban ende fushat e vjetra "flat" (item/quantity/unit/
// subjectOrClass) — nxënëse për prapa-përputhshmëri gjatë kalimit te struktura
// e re (kërkesë + shumë artikuj, shih MaterialRequestItem). Ato do të hiqen
// vetëm pasi çdo kod lexues/shkrues të kalojë te `items[]`, jo tani — shih
// scripts/migrate-material-requests.ts dhe planin e migrimit.
model MaterialRequest {
  id             Int          @id @default(autoincrement())
  teacherId      Int
  teacher        User         @relation("MaterialRequestTeacher", fields: [teacherId], references: [id])
  // Fusha të vjetra (nga struktura flat "1 kërkesë = 1 artikull") — lihen si
  // opsionale (jo hequr) që rreshtat historikë të mos humbin të dhëna; që nga
  // Faza 3 çdo kërkesë e re përdor items[] në vend të tyre.
  item           String?
  quantity       Int?
  unit           String?      // copë, metër, kg, litër, paketë
  subjectOrClass String?
  reason         String
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED — do të zgjerohet te statuset e reja pasi kodi konsumues të kalojë te items[]
  reviewedById   Int?
  reviewedBy     User?        @relation("MaterialRequestReviewer", fields: [reviewedById], references: [id])
  reviewNote     String?
  reviewedAt     DateTime?
  sentAt         DateTime?    // kur i-u dërgua email personit të blerjeve (FurnitoriOra)
  sentToEmail    String?
  sentSmsAt      DateTime?    // kur i-u dërgua SMS personit të blerjeve (FurnitoriOra) — vepron pavarësisht nga email-i
  sentToPhone    String?
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Fusha të reja (nullable — shtim aditiv, s'prek rreshtat ekzistues)
  priority       String?      // NORMAL, IMPORTANT, URGENT
  dateNeeded     DateTime?
  classId        Int?
  class          Class?       @relation(fields: [classId], references: [id])
  subjectId      Int?
  subject        Subject?     @relation(fields: [subjectId], references: [id])
  comment        String?
  submittedAt    DateTime?
  // Forma e re e mësuesit — shtuar 2026-10 (kërkesat e vjetra i kanë null)
  originalText   String?      // teksti i lirë siç e shkroi mësuesi
  mode           String?      // TEXT | CATALOG
  urgencyReason  String?
  classScope     String?      // CLASS | MULTI | SELF
  classIdsJson   String?      // JSON [id] për "Disa klasa"
  deliveredAt    DateTime?    // "Dorëzuar" te mësuesi
  deliveredById  Int?
  // Forma e re: "Shto foto ose link (opsionale)" për gjithë kërkesën
  attachmentPath String?
  productLink    String?

  items          MaterialRequestItem[]
  statusHistory  MaterialRequestStatusHistory[]

  @@index([status])
  @@index([teacherId])
}

model MaterialCategory {
  id             Int          @id @default(autoincrement())
  name           String
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  materials      Material[]
  customRequestItems MaterialRequestItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Subject {
  id             Int          @id @default(autoincrement())
  name           String
  active         Boolean      @default(true)
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  requests       MaterialRequest[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Material {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  categoryId     Int
  category       MaterialCategory @relation(fields: [categoryId], references: [id])
  name           String
  description    String?
  defaultUnit    String       @default("copë")
  needsColor     Boolean      @default(false)
  sku            String?
  supplierId     Int?
  supplier       Sipartner?   @relation(fields: [supplierId], references: [id])
  defaultPrice   Float?
  minStock       Int          @default(0)
  maxStock       Int?
  currentStock   Int          @default(0)
  active         Boolean      @default(true)
  source         String       @default("CATALOG") // CATALOG, FROM_CUSTOM_REQUEST
  requestItems   MaterialRequestItem[]
  orderItems     MaterialOrderItem[]
  transactions   MaterialInventoryTransaction[]
  aliases        MaterialAlias[]
  // Artikuj të krijuar automatikisht nga teksti i mësuesit — "pending" derisa t'i rishikojë administrata
  reviewStatus   String       @default("approved") // approved | pending
  createdById    Int?
  createdFromRequestId Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, active])
  @@index([organizationId, categoryId])
}

model MaterialRequestItem {
  id                 Int              @id @default(autoincrement())
  requestId          Int
  request            MaterialRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  materialId         Int?
  material           Material?        @relation(fields: [materialId], references: [id])
  isCustom           Boolean          @default(false)
  customItemName     String?
  customDescription  String?
  customCategoryId   Int?
  customCategory     MaterialCategory? @relation(fields: [customCategoryId], references: [id])
  productLink        String?          // vetëm artikull i veçantë
  attachmentPath     String?          // vetëm artikull i veçantë
  quantity           Int
  unit               String
  color              String?
  itemReason         String?          // mbivendos arsyen e përbashkët të kërkesës, opsionale
  status             String           @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedQuantity   Int?
  approvalNote       String?
  addedToCatalogAsId Int?             // vendoset kur admini e shton artikullin e veçantë në katalog
  // Forma e re (tekst i lirë) — shtuar 2026-10
  sourceText         String?          // pjesa e tekstit të mësuesit që e krijoi këtë rresht
  matchType          String?          // exact | alias | fuzzy | new | manual | ai | catalog (null = rresht i vjetër)
  confirmedByTeacher Boolean          @default(false)
  // Sa ka ardhur nga porositë për këtë artikull (llogaritet nga pranimi i porosisë,
  // shih src/lib/materialRequestStatus.ts) — bazë për statusin "Dorëzuar"
  deliveredQuantity  Int              @default(0)
  orderLinks         MaterialOrderRequestItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([requestId])
  @@index([materialId])
}

model MaterialRequestStatusHistory {
  id          Int             @id @default(autoincrement())
  requestId   Int
  request     MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  changedById Int
  changedBy   User            @relation("MaterialRequestStatusChangedBy", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime        @default(now())

  @@index([requestId])
}

model MaterialOrder {
  id                   Int          @id @default(autoincrement())
  organizationId       Int          @default(1)
  organization         Organization @relation(fields: [organizationId], references: [id])
  orderNumber          String       @unique // "MAT-{vit}-{sekuencë}"
  supplierId           Int?
  supplier             Sipartner?   @relation(fields: [supplierId], references: [id])
  status               String       @default("DRAFT") // DRAFT, PENDING, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  orderDate            DateTime     @default(now())
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  notes                String?
  totalItems           Int          @default(0)
  totalQuantity        Int          @default(0)
  estimatedCost        Float        @default(0)
  actualCost           Float        @default(0)
  createdById          Int
  createdBy            User         @relation(fields: [createdById], references: [id])
  items                MaterialOrderItem[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([organizationId, status])
}

model MaterialOrderItem {
  id               Int           @id @default(autoincrement())
  orderId          Int
  order            MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId       Int?
  material         Material?     @relation(fields: [materialId], references: [id])
  customItemName   String?       // rezervë nëse artikulli s'është premtuar ende në katalog
  color            String?       // artikujt me ngjyra të ndryshme grupohen në rreshta të ndarë
  unit             String
  quantity         Int           // sasia e porositur
  unitPrice        Float?
  totalPrice       Float?
  receivedQuantity Int           @default(0)
  receivedAt       DateTime?
  receiveNotes     String?
  requestLinks     MaterialOrderRequestItem[]
  transactions     MaterialInventoryTransaction[]

  @@index([orderId])
}

// Lidh një rresht porosie me disa kërkesa/artikuj individualë njëkohësisht
// (p.sh. "7 mësimdhënëse kërkuan marker = 63 copë" grupuar në një rresht porosie).
model MaterialOrderRequestItem {
  id                  Int                 @id @default(autoincrement())
  orderItemId         Int
  orderItem           MaterialOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  requestItemId       Int
  requestItem         MaterialRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  quantityContributed Int

  @@unique([orderItemId, requestItemId])
  @@index([requestItemId])
}

model MaterialInventoryTransaction {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  materialId     Int
  material       Material     @relation(fields: [materialId], references: [id])
  type           String       // RECEIVED, ADJUSTMENT
  quantity       Int          // e nënshkruar (+/-)
  balanceAfter   Int
  orderItemId    Int?
  orderItem      MaterialOrderItem? @relation(fields: [orderItemId], references: [id])
  note           String?
  createdById    Int
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, materialId])
}

model Payment {
  id            Int              @id @default(autoincrement())
  studentId     Int
  student       Student          @relation(fields: [studentId], references: [id])
  categoryId    Int
  category      PaymentCategory  @relation(fields: [categoryId], references: [id])
  amount        Float
  discount      Float            @default(0)
  discountType  String?          // percentage, fixed
  scholarship   Float            @default(0)
  finalAmount   Float
  dueDate       DateTime
  paidDate      DateTime?
  paidAmount    Float            @default(0)
  balance       Float            @default(0)
  method        String?          // CASH, BANK, CARD, ONLINE
  status        String           @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  description   String?
  note          String?          // shënim i lirë i stafit (p.sh. "borxh i vjetër nga 2025-2026")
  invoiceId     Int?
  invoice       Invoice?         @relation(fields: [invoiceId], references: [id])
  month         Int?             // 1-12 for monthly payments
  year          Int?
  receiptNumber  String?          @unique
  familyReceiptId Int?            // grupon disa Payment (nga fëmijë të ndryshëm të së njëjtës familje)
  familyReceipt   FamilyReceipt?  @relation(fields: [familyReceiptId], references: [id])
  // "Konfirmuar" = shuma e paguar konsiderohet e vërtetuar si e hyrë reale.
  // @default(true) — pagesat ekzistuese (futur me dorë deri tani) mbeten të
  // konfirmuara automatikisht. false vetëm kur krijohet nga import Excel (çdo
  // kategori) ose kur është pagesë Shkollimi për nxënës të lidhur me TIMI
  // Invest (shih POST /api/payments dhe /api/payments/import) — deri sa
  // dikush ta shqyrtojë manualisht te "Shkollimi → Verifikim".
  confirmed      Boolean          @default(true)
  // Kush e regjistroi pagesën — vendoset vetë nga shtresa e auditimit (src/lib/prisma.ts)
  // për pagesat e reja; bosh për pagesat e vjetra (shih AuditLog/FinAuditLog).
  createdById    Int?
  organizationId Int              @default(1)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([familyReceiptId])
  @@index([studentId, categoryId])
  @@index([organizationId, paidDate])
}

// Grupon disa pagesa (Payment) nga fëmijë të ndryshëm të së njëjtës familje, të regjistruara
// dhe të paguara njëkohësisht, në një dëshmi/fletëpagesë të vetme të printueshme — çdo Payment
// mbetet i lidhur individualisht me nxënësin e tij (gjurma financiare e secilit qëndron e saktë),
// vetëm printimi/faturimi i shfaqet stafit si një dokument i vetëm.
model FamilyReceipt {
  id             Int          @id @default(autoincrement())
  receiptNumber  String       @unique  // FAM-{vit}-{sekuencë}
  parentName     String?
  parentPhone    String?
  method         String?      // CASH, BANK, CARD, ONLINE
  totalAmount    Float        @default(0)
  paidDate       DateTime     @default(now())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  uniSales       UniSale[]
  bookSales      BookSale[]
  createdAt      DateTime     @default(now())
}

model Invoice {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  type        String        // INVOICE, PROFORMA, OFFER
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id])
  items       InvoiceItem[]
  subtotal    Float
  vatRate     Float         @default(0)
  vatAmount   Float         @default(0)
  total       Float
  status      String        @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  dueDate     DateTime?
  paidDate    DateTime?
  notes       String?
  convertedInvoiceId Int?   // kur type=PROFORMA dhe eshte konvertuar, id e Invoice-it real te krijuar
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model InvoiceItem {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Cili fëmijë i përket ky zë — opsionale, që një faturë e vetme e prindit
  // të mund të mbulojë disa fëmijë (secili zë me nxënësin e vet). Bosh =
  // zë i përgjithshëm/i përbashkët, jo i lidhur me një fëmijë specifik.
  studentId     Int?
  student       Student? @relation(fields: [studentId], references: [id])
  description   String
  quantity      Float    @default(1)
  regularPrice  Float    @default(0)
  discountPct   Float    @default(0)
  unitPrice     Float
  total         Float

  @@index([studentId])
}

// ── Sistemi i Uniformave ──────────────────────────────────

model UniProduct {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  photo       String?
  buyPrice    Float
  sellPrice   Float
  stock       Int            @default(0)
  stockAlert  Int            @default(5)
  active      Boolean        @default(true)
  saleItems   UniSaleItem[]
  orderItems  UniOrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model UniOrder {
  id           Int            @id @default(autoincrement())
  orderNumber  String         @unique
  supplier     String?
  status       String         @default("ORDERED") // ORDERED, RECEIVED, CANCELLED
  orderDate    DateTime       @default(now())
  receivedDate DateTime?
  notes        String?
  items        UniOrderItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model UniOrderItem {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     UniOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   UniProduct @relation(fields: [productId], references: [id])
  quantity  Int
  buyPrice  Float
  total     Float
}

model UniSale {
  id            Int           @id @default(autoincrement())
  studentId     Int?
  customerName  String
  customerPhone String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float         @default(0)
  balance       Float         @default(0)
  status        String        @default("PENDING")
  saleDate      DateTime      @default(now())
  notes         String?
  items         UniSaleItem[]
  payments      UniPayment[]
  familyReceiptId Int?        // bashkuar në një dëshmi pagese familjeje me shitje të tjera
  familyReceipt   FamilyReceipt? @relation(fields: [familyReceiptId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([familyReceiptId])
}

model UniSaleItem {
  id        Int        @id @default(autoincrement())
  saleId    Int
  sale      UniSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   UniProduct @relation(fields: [productId], references: [id])
  size      String?
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model UniPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      UniSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model UniHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  recipient   String?
  method      String   @default("CASH")
  handoverAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
}

// ── Librat e Anglishtes ───────────────────────────────────

model BookProduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  buyPrice    Float
  sellPrice   Float
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookSale {
  id            Int      @id @default(autoincrement())
  studentId     Int?
  studentName   String
  studentClass  String?
  totalAmount   Float
  totalCost     Float
  profit        Float
  paidAmount    Float    @default(0)
  balance       Float    @default(0)
  status        String   @default("PENDING")
  receiptNumber String?
  saleDate      DateTime @default(now())
  notes         String?
  familyReceiptId Int?   // bashkuar në një dëshmi pagese familjeje me shitje të tjera
  familyReceipt   FamilyReceipt? @relation(fields: [familyReceiptId], references: [id])
  sentSmsAt     DateTime? // kur i-u dërgua SMS kujtese borxhi prindit (butoni te lista e shitjeve)
  sentToPhone   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([familyReceiptId])
}

model BookSaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  buyPrice  Float
  sellPrice Float
  total     Float
  profit    Float
}

model BookPayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

model BookHandover {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  recipient   String?
  method      String   @default("CASH")
  handoverAt  DateTime @default(now())
  reference   String?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Student, Payment, Invoice, etc.
  entityId  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ── SMS ───────────────────────────────────────────────────
// Regjistër i çdo SMS-i të dërguar përmes gateway-t (RBSoft SMS Gateway apo
// çfarëdo tjetër që ekspozon një API të ngjashme) — një rresht për marrës,
// edhe kur dërgimi është "në grup" (bashkuar nën të njëjtin batchId që të
// duket si një veprim i vetëm në histori).
model SmsMessage {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  batchId        String?      // grupon dërgimet "në grup" (klasë/familje/shumë të zgjedhur)
  recipientPhone String
  recipientName  String?
  studentId      Int?
  student        Student?     @relation(fields: [studentId], references: [id])
  message        String
  status         String       @default("PENDING") // PENDING, SENT, FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User         @relation(fields: [sentById], references: [id])
  // Opsionale (shtuar 2026-10) — lloji i mesazhit (SHKOLLIMI, USHQIMI, ...) dhe
  // statusi i pagesës në momentin e dërgimit; për mbrojtjen nga dërgimi i
  // dyfishtë. Mesazhet e vjetra mbeten null.
  messageType    String?
  paymentStatus  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([batchId])
  @@index([studentId])
  @@index([messageType, createdAt])
}

// Log i dërgimeve email nga karta e Familjes ("Buton Email") — mesazh i lirë
// (subjekt+tekst), jo email transaksional. Mirror i SmsMessage.
model FamilyEmailLog {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(1)
  organization   Organization @relation(fields: [organizationId], references: [id])
  batchId        String?
  recipientEmail String
  recipientName  String?
  studentId      Int?
  student        Student?     @relation(fields: [studentId], references: [id])
  subject        String
  message        String
  status         String       // SENT | FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User         @relation(fields: [sentById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([batchId])
  @@index([studentId])
}

// Bibliotekë dokumentesh të përgjithshme të shkollës (katalogë, broshura,
// rregullore, etj.) — të ngarkueshme nga Administrata, me mundësi dërgimi
// me email te prindërit. Skedari ruhet në disk (si material-attachments),
// jo në databazë.
model SchoolDocument {
  id               Int          @id @default(autoincrement())
  organizationId   Int          @default(1)
  organization     Organization @relation(fields: [organizationId], references: [id])
  title            String
  description      String?
  category         String?
  fileName         String       // emri i ruajtur në disk (UUID+ext)
  originalFileName String
  mimeType         String
  size             Int
  uploadedById     Int
  uploadedBy       User         @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime     @default(now())
  emailLogs        DocumentEmailLog[]

  @@index([organizationId, category])
}

model DocumentEmailLog {
  id             Int            @id @default(autoincrement())
  documentId     Int
  document       SchoolDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  batchId        String?
  recipientEmail String
  recipientName  String?
  studentId      Int?
  student        Student?       @relation(fields: [studentId], references: [id])
  status         String         // SENT | FAILED
  errorMessage   String?
  sentById       Int
  sentBy         User           @relation(fields: [sentById], references: [id])
  createdAt      DateTime       @default(now())

  @@index([documentId])
  @@index([batchId])
}

// ── TIMI INVEST ───────────────────────────────────────────

model TimiInvestStudent {
  id           Int      @id @default(autoincrement())
  firstName    String
  lastName     String
  parentName   String
  parentPhone  String
  regularPrice    Float
  discountPct     Float    @default(0)
  manualDiscAmt   Float    @default(0)
  studentId    Int?     // lidhje me Student.id kryesor (opsionale)
  active       Boolean  @default(true)
  stage        String   @default("PROFATURE") // PROFATURE | NE_PROCES | KRYER — pipeline i klientit, i ndarë nga `active` (arkivim)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TimiInvestInvoice {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  seq              Int
  month            Int
  year             Int
  parentName       String
  date             DateTime @default(now())
  items            String   // JSON: [{name, regularPrice, discountPct, finalAmount}]
  timiStudentIds   String?  // JSON: [TimiInvestStudent.id, ...] — lidhje e qëndrueshme me fëmijët
  totalAmount      Float
  timiDiscPct      Float    @default(4.66)
  timiDiscAmt      Float
  finalAmount      Float
  notes            String?
  schoolYear       String?
  regularInvoiceId Int?     @unique // Invoice.id — nëse është konvertuar në faturë të rregullt
  createdAt        DateTime @default(now())
}

// ── Fletorja Digjitale e Adminit ──────────────────────────

model AdminNote {
  id        Int      @id @default(autoincrement())
  title     String?
  content   String
  color     String   @default("slate") // slate, blue, yellow, green, red, purple, orange
  tags      String?  // comma-separated
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminTask {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  assignedTo  String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE, CANCELLED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminReminder {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   @default("GENERAL") // PAYMENT, MEETING, DOCUMENT, GENERAL
  dueDate     DateTime
  done        Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("GENERAL") // EXAM, MEETING, ACTIVITY, HOLIDAY, GENERAL
  color       String    @default("blue")
  allDay      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Stafi ─────────────────────────────────────────────────

model Staff {
  id          Int      @id @default(autoincrement())
  emri        String
  telefoni    String?
  lenda       String?
  nrPersonal  String?
  nrLlogarise String?
  banka       String?
  totalBruto  Float?
  kontrata        String?
  llojiKontrates  String?
  cmimOres        Float?
  oreMuaj         Int?
  adresa          String?
  kodi            String?
  tipi            String?
  status          String   @default("ACTIVE")
  // Fushat e mëposhtme u shtuan për t'u përputhur me template-in Excel të
  // stafit (Nr.Personal, Datëlindja, ... Pozita) — shih /sekretaria/stafi.
  dataLindjes     DateTime?
  vendlindja      String?
  gjinia          String?
  shtetesia       String?
  email           String?
  dataFillimit    DateTime?
  orari           String?
  niveliShkollimit String?
  profesioni      String?
  pozita          String?
  // Data e mbarimit të kontratës (shtuar 2026-10 për panelin e Sekretarisë:
  // "Skadojnë së shpejti / Të skaduara") — null = pa datë
  contractEndDate DateTime?
  assistedStudents StudentSpecialCare[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Investim {
  id             Int      @id @default(autoincrement())
  tipi           String   // KAPITAL, PERKOHSHEM
  data           DateTime @default(now())
  pershkrim      String
  kategoria      String?
  vlera          Float
  metoda         String   @default("CASH") // CASH, BANK, CARD, TRANSFER
  dokumenti      String?
  regjistruarNga String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipi])
  @@index([data])
}

model Hyra {
  id        Int      @id @default(autoincrement())
  paguesit  String
  shuma     Float
  kategoria String   @default("SHKOLLIMI")
  muaj      Int
  vit       Int
  metoda    String?  // CASH, BANK
  referenca String?
  shenime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vit, muaj])
  @@index([paguesit])
}

model DocArchive {
  id          Int      @id @default(autoincrement())
  type        String   // FLETEKALIM_CL, FLETEKALIM_CU, PASQYRE_CU, VERTETIM_CL, VERTETIM_NXENES, VERTETIM_MESIMDHENES, VERTETIM_ASISTENTE, KONTRATE_NXENES, KONTRATE_MESIMDHENES
  studentId   Int?
  staffId     Int?     // për dokumentet e stafit (vërtetim/kontratë) — atëherë studentName = emri i punonjësit
  studentName String
  className   String?
  data        String   // JSON: të gjitha fushat e modalit
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([studentId])
  @@index([staffId])
  @@index([createdAt])
}

// Mbyllja e Vitit — hapat që s'mund të llogariten nga të dhënat (p.sh. "Notat
// përfundimtare të futura") shënohen me dorë nga paneli i Sekretarisë.
model YearClosingCheck {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  yearLabel      String   // viti që po mbyllet, p.sh. "2026-2027"
  stepKey        String   // GRADES | DEBTS
  doneById       Int?
  doneByName     String?
  doneAt         DateTime @default(now())

  @@unique([organizationId, yearLabel, stepKey])
}

// "Numëro arkën" (Dashboard → Pasqyra financiare e shkollimit): historiku i
// numërimeve — sa u numërua fizikisht kundrejt "Në arkë" sipas sistemit.
model CashCount {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  yearLabel      String   // viti shkollor i pasqyrës, p.sh. "2026-2027"
  countedAmount  Float    // shuma e numëruar
  systemAmount   Float    // "Në arkë" sipas sistemit në atë moment
  difference     Float    // countedAmount − systemAmount (negative = mungojnë)
  userId         Int?
  userName       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}

model LibriAme {
  id            Int      @id @default(autoincrement())
  studentId     Int      @unique
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vendiLindjes  String?
  shteti        String?
  shtetas       String?
  komuna        String?
  adresaPrindit String?
  notat         String?  // JSON: grades Kl.6-9
  levizjet      String?  // JSON: page 2 Kl.6-9
  notatFillore  String?  // JSON: grades Kl.1-5
  levizjetFillore String? // JSON: page 2 Kl.1-5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Historiku i Nxënësit ──────────────────────────────────
// Vijë kohore e ngjarjeve për një nxënës (paneli "Historiku" te faqja e
// Nxënësve). Shkruhet VETËM përmes src/lib/studentHistory.ts (recordStudentEvent)
// — një vend qendror, që s'e ndërpret kurrë veprimin kryesor nëse dështon.
// `source = "backfill"` — ngjarje të rindërtuara nga të dhënat ekzistuese.
model StudentHistory {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String   // REGJISTRIM, PAGESE, KONTRATE, SMS, NDRYSHIM_KLASE, ZBRITJE, NDRYSHIM_TE_DHENASH, CREGJISTRIM
  title       String   // p.sh. "Pagesë 500 €"
  description String?
  data        String?  // JSON: shuma, vlera e vjetër/e re, kategoria...
  userId      Int?     // null = ngjarje e rindërtuar ose automatike
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  occurredAt  DateTime // data reale e ngjarjes
  source      String   @default("auto") // auto | backfill
  sourceKey   String?  // çelës unik për backfill (p.sh. "payment:123") — parandalon dyfishimin
  createdAt   DateTime @default(now())

  @@index([studentId, occurredAt])
  @@index([type])
  @@index([sourceKey])
}

// ── Kujdes i veçantë (të dhëna të NDJESHME) ───────────────
// Lexohen/shkruhen VETËM përmes /api/special-care (leje në backend, shih
// src/lib/specialCare.ts — Super Admin, Admin, Pedagogia). Historiku i
// nxënësit regjistron ndryshimin, por KURRË përmbajtjen e shënimeve.
model StudentSpecialCare {
  id               Int       @id @default(autoincrement())
  studentId        Int
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hasAssistant     Boolean   @default(false) // "Me asistent"
  specialNeeds     Boolean   @default(false) // "Nevoja të veçanta"
  note             String?   // shënim i shkurtër për mësuesin
  iep              Boolean   @default(false) // Plan Edukativ Individual (PEI)
  iepReviewDate    DateTime?
  startDate        DateTime?
  endDate          DateTime?
  assistantStaffId Int?
  assistant        Staff?    @relation(fields: [assistantStaffId], references: [id], onDelete: SetNull)
  organizationId   Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([studentId])
  @@index([assistantStaffId])
}

// Fotografi e klasave për çdo vit shkollor (mësuesi, kapaciteti, numri i
// nxënësve) — ruhet në kalimin e vitit, që vitet e kaluara të shihen te Klasat.
model ClassYearSnapshot {
  id              Int      @id @default(autoincrement())
  organizationId  Int      @default(1)
  schoolYearLabel String   // p.sh. "2025-2026"
  academicYear    Int      // viti fillestar, p.sh. 2025
  classId         Int?     // referencë e thjeshtë (klasa mund të fshihet më vonë)
  className       String
  level           String?
  teacher         String?
  capacity        Int?
  active          Boolean  @default(true)
  studentCount    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([organizationId, academicYear])
}

// Sinonime/fjalë alternative për artikujt e katalogut — përdoren nga motori i
// përputhjes (src/lib/materialMatcher.ts). Krijohen nga administrata ose
// automatikisht kur bashkohet/lidhet një tekst i mësuesit ("sistemi mëson").
model MaterialAlias {
  id          Int      @id @default(autoincrement())
  materialId  Int
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  alias       String
  normalized  String   // forma e normalizuar (pa ë/ç, pa mbaresa) për përputhje
  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([materialId, normalized])
  @@index([normalized])
}

// Historiku i statuseve të aplikimit (kush dhe kur) — shkruhet nga
// recordApplicationStatus() te src/lib/enrollmentRules.ts.
model ApplicationStatusHistory {
  id            Int                   @id @default(autoincrement())
  applicationId Int
  application   EnrollmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  userId        Int?
  userName      String?
  note          String?
  createdAt     DateTime              @default(now())

  @@index([applicationId])
}

// ── Familjet ──────────────────────────────────────────────
// Rekordi i familjes (shtuar 2026-10). Lidhja fillestare: sipas telefonit të
// prindit (src/lib/families.ts), me rindërtim nga Super Admin; nxënësit e rinj
// lidhen automatikisht. Bashkimet sipas emrit bëhen vetëm me konfirmim.
model Family {
  id             Int       @id @default(autoincrement())
  organizationId Int       @default(1)
  displayName    String?   // p.sh. "Krasniqi" — bosh = nga mbiemri i fëmijëve
  primaryContact String?   // FATHER | MOTHER | GUARDIAN — kush merr SMS-të
  students       Student[]
  notes          FamilyNote[]
  documents      FamilyDocument[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model FamilyNote {
  id         Int      @id @default(autoincrement())
  familyId   Int
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  text       String
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  createdAt  DateTime @default(now())

  @@index([familyId])
}

model FamilyDocument {
  id           Int      @id @default(autoincrement())
  familyId     Int
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  studentId    Int?     // opsionale — dokument i një fëmije të caktuar
  title        String?
  fileName     String   // emri i ruajtur në disk
  originalName String
  contentType  String
  size         Int
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([familyId])
}

// Asistenti "Ora" — regjistri i pyetjeve (pa përgjigjet e plota me të dhëna
// personale; vetëm përmbledhja). Fshihet pas periudhës së ruajtjes (Cilësimet
// → oraRetentionDays). Shih src/ora/.
model OraQuery {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  userId         Int?
  role           String?
  question       String
  toolsJson      String?  // JSON: [{ name, input }] — veglat e thirrura me parametrat
  status         String   // ANSWERED | UNANSWERED | CLARIFICATION | ERROR | DENIED
  summary        String?  // p.sh. "count_students → 35"
  durationMs     Int?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  rating         Int?     // 1 = 👍, -1 = 👎
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

// Regjistri i dërgimit të porosive te furnitori (SMS / email) nga paneli
// "Për t'u porositur" — çfarë u dërgua, kujt, nga kush dhe rezultati i çdo kanali.
// orderId = porosia (MaterialOrder) e krijuar; null kur asnjë kanal s'pati sukses.
model MaterialOrderDispatch {
  id           Int      @id @default(autoincrement())
  organizationId Int    @default(1)
  orderId      Int?
  supplierName String
  toEmail      String?
  toPhone      String?
  replyTo      String?
  channels     String   // "SMS", "EMAIL" ose "SMS,EMAIL"
  smsText      String?
  emailSubject String?
  emailHtml    String?
  itemsJson    String   // [{ name, quantity, unit }]
  smsStatus    String?  // SENT | FAILED (null = kanali s'u zgjodh)
  smsError     String?
  emailStatus  String?
  emailError   String?
  sentById     Int
  sentByName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([orderId])
}

// Lirimi nga pagesa (Eshkollori → "Liro nga pagesa"): falas plotësisht ose
// zbritje në %. Vlen nga `fromYear` (viti fillestar akademik) deri `untilYear`
// (null = "Deri sa ta ndryshoj"). Anulimi s'e fshin — mbetet në histori.
model FeeExemption {
  id             Int       @id @default(autoincrement())
  organizationId Int       @default(1)
  studentId      Int
  categoryId     Int
  type           String    // FULL | PARTIAL
  percent        Float?    // vetëm PARTIAL
  reason         String    // SOCIAL | STAFF_CHILD | SIBLINGS | SCHOLARSHIP | OTHER
  reasonText     String?   // teksti kur reason = OTHER
  fromYear       Int
  untilYear      Int?
  createdById    Int
  createdByName  String?
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?
  cancelledById  Int?
  cancelledByName String?
  cancelReason   String?

  @@index([studentId, categoryId])
}

// Historiku i ndryshimeve të detyrimeve (Eshkollori): shuma, lirimi, borxhi i
// vjetër (shtim/ndryshim/falje/fshirje) dhe pagesat — vlera e vjetër, e reja,
// arsyeja, kush dhe kur.
model FeeChangeLog {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  studentId      Int
  categoryId     Int
  year           Int?     // viti fillestar akademik që prek
  action         String   // PAYMENT | AMOUNT | EXEMPT | EXEMPT_CANCEL | OLD_DEBT_ADD | OLD_DEBT_EDIT | OLD_DEBT_FORGIVE | OLD_DEBT_VOID
  oldValue       Float?
  newValue       Float?
  reason         String?
  detail         String?
  refId          Int?     // Payment/FeeExemption përkatës
  userId         Int
  userName       String?
  createdAt      DateTime @default(now())

  @@index([studentId, categoryId, createdAt])
}

// Shënim i nxënësit për një modul dhe vit shkollor (p.sh. Ushqimi → "Zbritje e
// paparashikueshme"): administrata i zgjedh me dorë; shfaqet si etiketë me ngjyrë
// dhe përdor ditët e kolonës "Zbritje e paparashikueshme" te pagesat e reja.
model StudentTag {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  studentId      Int
  module         String   // USHQIMI
  schoolYear     Int      // viti fillestar akademik, p.sh. 2026 = 2026–2027
  label          String
  createdById    Int?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@unique([studentId, module, schoolYear])
  @@index([module, schoolYear])
}

// ── Auditimi financiar — Faza 1 ───────────────────────────
// Gjurma e çdo ndryshimi në tabelat financiare. Rreshtat i shkruajnë VETËM
// triggers e SQLite (src/lib/audit/triggers.ts), kështu që kapet edhe një
// ndryshim i bërë jashtë aplikacionit. Vetëm shtim: triggers bllokojnë çdo
// UPDATE/DELETE mbi këtë tabelë, për çdo rol.
model FinAuditLog {
  id        Int      @id @default(autoincrement())
  tableName String
  recordId  Int?
  action    String   // CREATE, UPDATE, DELETE
  oldValues String?  // JSON — rreshti para ndryshimit
  newValues String?  // JSON — rreshti pas ndryshimit
  userId    Int?
  userName  String?
  ip        String?
  userAgent String?
  reason    String?
  source    String   @default("DB") // APP = nga aplikacioni (me përdorues), DB = pa kontekst (sistem/jashtë app-it)
  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@index([tableName, createdAt])
  @@index([createdAt])
  @@index([userId])
}

// Konteksti i kërkesës (përdoruesi, IP, arsyeja) që triggers e lexojnë.
// Një rresht i vetëm (id=1), i vendosur dhe i fshirë brenda të njëjtit
// transaksion me ndryshimin — jashtë transaksionit është gjithmonë bosh.
model FinAuditContext {
  id        Int     @id
  userId    Int?
  userName  String?
  ip        String?
  userAgent String?
  reason    String?
}

// ── Auditimi financiar — Faza 2: numërimi i arkave ──
// Një rresht për çdo numërim të një arke (çdo burim ka arkën e vet: box).
// Numërohet kur të jepet mundësia — pa afat. Shumat në CENT (numra të plotë).
// Gjendja sipas sistemit = shuma e numëruar herën e kaluar + lëvizjet cash
// sipas DATËS REALE (nga FinAuditLog, src/lib/audit/cashClosing.ts).
// kind=OPENING: numërimi i parë (gjendja fillestare) — pika e nisjes së zinxhirit.
model CashClosing {
  id             Int       @id @default(autoincrement())
  organizationId Int       @default(1)
  box            String    @default("") // "CAT:<id>" (kategori pagese), "UNIFORMA", "LIBRAT"
  date           String    // "YYYY-MM-DD" (ora e Kosovës)
  kind           String    @default("DAILY") // OPENING, DAILY
  scope          String    // JSON: arka (box) dhe emri i saj në momentin e numërimit
  openingCents   Int       @default(0)
  inCents        Int       @default(0)
  outCents       Int       @default(0)
  lateCents      Int       @default(0)  // neto i regjistrimeve të vonuara për ditë të mbyllura më parë
  lastLogId      Int       @default(0)  // FinAuditLog.id i fundit i llogaritur — lëvizjet deri këtu i takojnë kësaj mbylljeje ose më parë
  systemCents    Int
  countedCents   Int
  diffCents      Int       // countedCents − systemCents (negative = mungojnë)
  breakdown      String?   // JSON: lëvizjet sipas llojit + regjistrimet e vonuara
  note           String?
  countedById    Int?
  countedByName  String?
  verifiedById   Int?
  verifiedByName String?
  verifiedAt     DateTime?
  verifyNote     String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, box, date])
}

// Gjetjet e auditimit (Faza 2 i krijon për arkën; Faza 3 shton motorin e rregullave).
// fingerprint unik — e njëjta gjetje s'krijohet dy herë.
model AuditFinding {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  ruleCode       String
  runId          Int?
  severity       String   // KRITIKE, E_LARTE, MESATARE, E_ULET
  module         String   // ARKA, SHKOLLIMI, ...
  entityType     String?
  entityId       Int?
  amountCents    Int?
  title          String
  description    String?
  evidence       String?  // JSON
  status         String   @default("E_RE") // E_RE, NE_SHQYRTIM, E_JUSTIFIKUAR, E_KORRIGJUAR
  assignedToId   Int?
  fingerprint    String   @unique
  lastSeenAt     DateTime? // ekzekutimi i fundit që e gjeti ende (null = s'është parë nga motori)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, severity])
  @@index([ruleCode])
  @@index([entityType, entityId])
}

model AuditFindingComment {
  id         Int      @id @default(autoincrement())
  findingId  Int
  userId     Int?
  userName   String?
  text       String
  statusFrom String?
  statusTo   String?
  createdAt  DateTime @default(now())

  @@index([findingId])
}

// ── Auditimi financiar — Faza 3: motori i rregullave ──
// Përkufizimet e rregullave (sinkronizohen nga kodi, src/lib/audit/rules) —
// "active" dhe "severity" mund të ndryshohen pa prekur kodin.
model AuditRule {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String
  module      String
  severity    String   // KRITIKE, E_LARTE, MESATARE, E_ULET
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Çdo ekzekutim i motorit (natën, manual, ose në nisje pas një nate të humbur).
model AuditRun {
  id            Int       @id @default(autoincrement())
  trigger       String    // NATA, MANUAL, NISJA
  status        String    @default("RUNNING") // RUNNING, OK, ME_GABIME, DESHTOI
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  findingsNew   Int       @default(0)
  findingsSeen  Int       @default(0)
  ruleStats     String?   // JSON: kodi → { gjetje, ms, gabim? }
  error         String?
  userName      String?

  @@index([startedAt])
  @@index([status])
}

// Pagesat pjesë-pjesë të një fature/shpenzimi (p.sh. 2.200 € nga 17.600 €).
// Çdo pagesë zbret nga arka (cash) ose banka në DATËN e vet. Shuma në CENT.
// kategoriId = kopje e kategorisë së faturës (për arkën dhe auditimin, që s'e njohin faturën).
model ShpenzimPagese {
  id            Int      @id @default(autoincrement())
  shpenzimId    Int
  shpenzim      Shpenzim @relation(fields: [shpenzimId], references: [id])
  kategoriId    Int
  shumaCents    Int
  data          DateTime
  metoda        String   // CASH, BANK, CARD
  shenim        String?
  createdById   Int?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shpenzimId])
  @@index([data])
}

// ── Arka fizike: transferet ndërmjet arkës dhe bankës ──
// Depozitë (BOX_TO_BANK): paraja del nga arka dhe hyn në bankë — s'është shpenzim
// dhe s'është dorëzim te një person. Tërheqje (BANK_TO_BOX): e kundërta.
// Shumat në CENT. Data = data REALE e lëvizjes. Logjika: src/lib/cashLedger.ts
model CashTransfer {
  id             Int      @id @default(autoincrement())
  organizationId Int      @default(1)
  box            String   // arka: "CAT:<id>" (si te CashClosing)
  direction      String   // BOX_TO_BANK, BANK_TO_BOX
  amountCents    Int
  date           DateTime
  reference      String?
  note           String?
  createdById    Int?
  createdByName  String?
  createdAt      DateTime @default(now())

  @@index([box, date])
}
