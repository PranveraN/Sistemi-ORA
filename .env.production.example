# ===========================================================================
# Akademia Ora — PRODUCTION environment
#
# Copy this file to ".env.production" and fill in the real values:
#     cp .env.production.example .env.production
#
# .env.production is gitignored — it holds secrets and must never be committed.
# ===========================================================================

# Public URL the system is served at (no trailing slash).
NEXTAUTH_URL="https://admin.akademiaora.com"
AUTH_URL="https://admin.akademiaora.com"

# Trust the reverse-proxy (nginx) forwarded headers. Required behind Cloudflare.
AUTH_TRUST_HOST="true"

# Session signing secret. Generate a strong one:
#     openssl rand -base64 32
# Keep BOTH variables set to the SAME value (NextAuth v5 reads AUTH_SECRET;
# NEXTAUTH_SECRET is the legacy name). If you ever change this, everyone is
# logged out.
AUTH_SECRET="CHANGE-ME-run-openssl-rand-base64-32"
NEXTAUTH_SECRET="CHANGE-ME-run-openssl-rand-base64-32"

# SQLite database location INSIDE the container (on the /data volume).
# Normally leave this as-is — docker-compose.yml also sets it.
DATABASE_URL="file:/data/akademia-ora.db"

# Host port nginx will proxy to. Change if 3000 is already used on the server.
APP_PORT="3000"

# Resend API key — required for the "Kërkesat" (material requests) feature to
# email teachers/suppliers. Get one at https://resend.com/api-keys.
# Without it, sendEmail() logs a warning and returns ok:false — the app still
# works, emails just silently don't go out.
# IMPORTANT: src/lib/email.ts sends from onboarding@akademiaora.com — Resend
# rejects sending from a domain that isn't verified in your Resend account
# (Domains → Add Domain → add the DNS records it gives you). Verify
# akademiaora.com there before relying on this.
RESEND_API_KEY="CHANGE-ME-re_xxxxxxxx"
