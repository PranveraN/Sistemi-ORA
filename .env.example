# ── ZHVILLIM LOKAL (SQLite) ───────────────────────────────────────────────────
# Kopjo si .env dhe lër kështu për zhvillim lokal:
DATABASE_URL="file:./akademia-ora.db"

# ── PRODHIM / DOMAIN (PostgreSQL) ────────────────────────────────────────────
# Zëvendëso me PostgreSQL kur vendos në server:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/akademia_ora"
#
# Gjithashtu ndrysho në prisma/schema.prisma:
#   provider = "postgresql"   (ishte "sqlite")
#
# Pastaj ekzekuto:
#   npx prisma migrate deploy
#   npm run db:seed

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Gjenero me: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="ndrysho-kete-me-nje-fjalekalim-te-forte-32-karaktere"

# URL-ja e plotë e domainit (pa / në fund)
NEXTAUTH_URL="https://sistemi.akademiaora.al"
